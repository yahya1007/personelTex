% \carre[labels]{cote}[nom_centre]
% --------------------------------------------------------------
\NewDocumentCommand{\carre}{ O{} m O{} }{%
  \begingroup
    \figsetdefault{#1}{A,B,C,D}{\figLbls}%
    \def\figC{#2}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figC,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](90:\figC){\figPtC}
    \tkzDefShiftPoint[\figPtA](90:\figC){\figPtD}

    \tkzDrawPolygon(\figPtA,\figPtB,\figPtC,\figPtD)

    \tkzLabelPoint[below](\figPtA){\figPtA}
    \tkzLabelPoint[below](\figPtB){\figPtB}
    \tkzLabelPoint[above](\figPtC){\figPtC}
    \tkzLabelPoint[above](\figPtD){\figPtD}

    \ifblank{#3}%
        {}%
        {%
          \tkzInterLL(\figPtA,\figPtC)(\figPtB,\figPtD)%
          \tkzGetPoint{#3}%
          \tkzDrawSegment(\figPtA,\figPtC)%
          \tkzDrawSegment(\figPtB,\figPtD)%
          \tkzDrawPoint(#3)%
          \tkzLabelPoint[below](#3){#3}%
        }%
  \endgroup
}

