  \tkzDrawSegment(\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{3})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{3})

  \tkzLabelPoint[left](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
