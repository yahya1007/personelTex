% Version multi-fichiers de \ChoisirExercices
\NewDocumentCommand\ChoisirExercicesMulti{m}{%
  \ifPfMTirageFige\else
 \PackageWarning{ProfModels}%
 {Tirage non fige : appelez \string\FixerTirageExo{N} AVANT
      \string\ChoisirExercicesMulti.}%
  \fi
  \stepcounter{PfMTirage}%
  \PfMSelectionActivetrue
  \gdef\PfMListeChoisis{}%
  
  \foreach \PfMFichSpec in {#1}{%
    \expandafter\PfM@ParseFichierSpec\expandafter{\PfMFichSpec}%
  }%
}

\def\PfM@ParseFichierSpec#1{%
  \PfM@ParseFichierSpecAux#1\@nil
}
\def\PfM@ParseFichierSpecAux#1=#2\@nil{%
  \edef\PfMNomFich{\zap@space#1 \@empty}%
  \edef\PfMNbExo{\zap@space#2 \@empty}%
  \PfM@TirerPourFichier
}

\newcommand\PfM@TirerPourFichier{%
  \edef\PfM@refval{\getrefnumber{PfMFinFichier\PfMNomFich}}%
  \edef\PfM@refzero{0}%
  \ifx\PfM@refval\PfM@refzero
  \PackageWarning{ProfModels}%
  {Nombre total d'exercices inconnu pour le fichier '\PfMNomFich'. Recompilez pour obtenir le tirage correct.}%
    \edef\PfMTotalCalcExo{\PfMNbExo}%
  \else
    \edef\PfMTotalCalcExo{\PfM@refval}%
  \fi
  
  \ifnum\PfMNbExo>\PfMTotalCalcExo\relax
    \PackageError{ProfModels}%
      {Impossible de choisir \PfMNbExo\space exercices parmi \PfMTotalCalcExo\space dans '\PfMNomFich'}%
      {Verifiez le nombre d'exercices disponibles dans ce fichier.}%
  \fi
  
  \foreach \PfMi in {1,...,\PfMNbExo}{%
    \edef\PfMTrouve{0}%
    \whiledo{\PfMTrouve=0}{%
      \pgfmathrandominteger{\PfMChoixExo}{1}{\PfMTotalCalcExo}%
      % NOUVELLE CLÉ : on ajoute "MULTI@" pour différencier
      \@ifundefined{PfMChoisiMULTI\thePfMTirage @\PfMNomFich @\PfMChoixExo}%
        {%
          \expandafter\xdef\csname
            PfMChoisiMULTI\thePfMTirage @\PfMNomFich @\PfMChoixExo\endcsname{1}%
          \ifx\PfMListeChoisis\@empty
            \xdef\PfMListeChoisis{\PfMNomFich:\PfMChoixExo}%
          \else
            \xdef\PfMListeChoisis{\PfMListeChoisis, \PfMNomFich:\PfMChoixExo}%
          \fi
          \edef\PfMTrouve{1}%
        }%
        {}%
    }%
  }%
}

% MODIFICATION CLÉE : On teste maintenant LES DEUX conventions
\renewcommand\PfM@VerifierAffichageParTirage{%
  \ifPfMSelectionActive
    % D'abord on teste le mode MULTI (avec nom de fichier)
