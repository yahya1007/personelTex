\tcbitem[raster multicolumn=6,raster multirow=2,blankest,raster height=\tcbtextheight]
\begin{tcbitemize}[raster columns=6,raster rows=2]
\tcbitem[enhanced jigsaw,raster multicolumn=6, fontupper=\bfseries, colback=white, boxrule=2pt, segmentation style={solid,gray!50!black,line width=2pt},
overlay unbroken and first={%
      \node[anchor=north east, yshift=-2mm] at ([yshift=\tcboverlaplower]segmentation.east) {\sffamily-- Calculatrice \ifboolKV[DS]{Calculatrice}{autorisée}{interdite} --};}]
   \begin{Large}
   \textbf{\sffamily Devoir Surveillé N\textsuperscript{\underline{o}} \useKV[DS]{Numero}}
        \end{Large}\hfill
