% NB : les cles des accumulateurs (\opadd/\opcopy) sont indexees par
% \theMaquette (et non plus par le compteur "section", qui n'a ici
% aucun rapport avec un \section reel : il n'est incremente que pour
% fabriquer un identifiant "en synchro" avec PfMExo). Utiliser
% \c@section posait probleme des qu'un document contient PLUSIEURS
% environnements Maquette : PfMExo est remis a 0 a chaque Maquette,
% mais pas section, donc les cles finissaient par se desynchroniser
% (et donc par melanger/ecraser les baremes de deux Maquette
% differentes). \theMaquette, lui, identifie sans ambiguite la
% Maquette courante.
% NB : \brm est appele depuis le CORPS de l'exercice, lequel est toujours
% execute meme quand l'exercice n'est pas affiche (Print=false, ou exercice
% ecarte par \ChoisirExercices) -- dans ce cas la boite est simplement
% "avalee" (\setbox...\egroup) sans etre montree. Or \c@PfMExo n'est
% incremente que pour les exercices REELLEMENT affiches (voir exerciceDS) :
% sans le test \ifPfMAfficherExo ci-dessous, un \brm dans un exercice masque
% ecrirait dans un accumulateur "totalN-0" (ou celui de l'exercice
% precedent) jamais declare, ce qui fait planter xlop avec "Number name
% `totalN-0' is undefined". On saute donc \brm pour les exercices masques
% (ce qui est aussi le comportement souhaite : leurs points ne doivent pas
% compter dans le barème total).
\newcommand*{\brm}[2][0]{%
  \ifboolKV[Boulot]{Fiche}{}{%
  \ifboolKV[Boulot]{DM}{}{%
  \ifPfMAfficherExo
    \immediate\write\@auxout{%
      \string\opadd*{#2}%
      {total\theMaquette-\the\c@PfMExo}%
      {total\theMaquette-\the\c@PfMExo}%
      \string\opcopy{\thePfMExo}{TotalExo\theMaquette}%
    }%
    \ifboolKV[ClesExercices]{BaremeDetaille}{%
%      \setlength{\brouillonBrm}{\BaremeEspace@Marge-\linewidth+\textwidth}%
%      \makebox[0pt][r]{\footnotesize\FranPt{#1}\hspace*{\brouillonBrm}}%
\reversemarginpar\marginnote{\footnotesize\FranPt{#2}}[#1 cm]
      \ignorespaces%
    }{}%
  \fi
  }}%
}%

\newcommand\total[1]{%
  \@ifundefined{Op@total#1}{recompilez}%
  {%
    \opunzero{total#1}% on ne sait jamais
    \opset{decimalsepsymbol={,}}
    \opprint{total#1}~%
    \opset{decimalsepsymbol={.}}
    \opcmp{total#1}{2}%
    \ifopge \useKV[ClesExercices]{MotPoint}s\else \useKV[ClesExercices]{MotPoint}\fi
  }%
}

\newcommand\NoteFinale{%
  \@ifundefined{Op@TotalExo\theMaquette}{Recompilez}%
  {%
    \opexport{TotalExo\theMaquette}{\TotalExo}%Le total d'exercices de cette Maquette est \TotalExo.
    \xdef\NoteTotale{0}%
    \xintFor* ##1 in {\xintSeq{1}{\TotalExo}}\do{%
      \@ifundefined{Op@total\theMaquette-##1}%
        {}% exercice sans bareme detaille (ou hors selection) : contribue pour 0
        {%
          \opexport{total\theMaquette-##1}{\totalUn}%
          \xdef\NoteTotale{\fpeval{\NoteTotale+\totalUn}}%
        }%
    }%
   \NoteTotale%
  }%
}%



