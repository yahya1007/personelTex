\newcommand*{\brm}[2][0]{%
  \ifboolKV[Boulot]{Fiche}{}{%
  \ifboolKV[Boulot]{DM}{}{%
  \ifPfMAfficherExo
    \immediate\write\@auxout{%
      \string\opadd*{#2}%
