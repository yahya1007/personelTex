%%%%%%%%%%%%%%% Begin Maquette %%%%%%%
% Environnement englobant le tout.
%\makeatletter
\NewDocumentEnvironment{Maquette}{om}{%
  % on remet à zéro le compteur des exercices
  \setcounter{PfMExo}{0}%
  \setcounter{PfMExoCatalogue}{0}%
  \PfMSelectionActivefalse% le tirage précédent (s'il y en a eu un) ne s'applique pas ici
  % nouvelles valeurs.
  \stepcounter{Maquette}%
  % options de boulot

  \useKVdefault[Boulot]%
  \setKV[Boulot]{#1}%

          \ifboolKV[Boulot]{DM}{%
            \setKV[DM]{#2}\TikzDM%
            \let\exercice\exerciceDM
            \let\endexercice\endexerciceDM}%
          {%
            \ifboolKV[Boulot]{Fiche}{%
              \setKV[Fiche]{#2}\TikzFiche%
              \let\exercice\exerciceFiche
              \let\endexercice\endexerciceFiche}%
            {%
              \ifboolKV[Boulot]{DS}{%
                \setKV[DS]{#2}\TikzDS%
                \let\exercice\exerciceDS
                \let\endexercice\endexerciceDS}%
              {%
              \ifboolKV[Boulot]{DevS}{%
                \setKV[DS]{#2}\TikzDevS%
                \let\exercice\exerciceDS
                \let\endexercice\endexerciceDS}%
              {%
		 \ifboolKV[Boulot]{Exam}{%
            \setKV[Exam]{#2}\TikzExam%
            \let\exercice\exerciceDS
            \let\endexercice\endexerciceDS}%
            {%
            \ifboolKV[Boulot]{Olym}{%
            \setKV[Olym]{#2}\TikzOlym%
            \let\exercice\exerciceDS
            \let\endexercice\endexerciceDS}%
          {}%
}}}}}}{%
  % A la fin de la Maquette : on pose un label numerique qui contient le
  % nombre total d'exercices rencontres (affiches ou non) dans cette
  % Maquette. \ChoisirExercices s'en sert (via refcount/\getrefnumber)
  % pour deduire automatiquement le second argument quand il est omis.
  % Astuce standard : on force \@currentlabel avant \label, puisque ce
  % label n'est pas lie a un \refstepcounter classique.
  \edef\@currentlabel{\thePfMExoCatalogue}%
  \label{PfMFinMaquette\theMaquette}%
}%    
%%%%%%%%%%%%%%%%%%% End Maquette %%%%%%%%%%%%%%% 


%---------- \anserdotline[number lines][distance] mode texte ------

\NewDocumentCommand\anserdotline{O{1}o}{%
  \foreach \PfMn in {1,...,#1}{%
    \IfNoValueTF{#2}%
      {\answerlinetoeol}%
      {\answerlinetowidth[#2]}%
    \par\vspace{10pt}%
  }%
}%

\newcommand\answerlinetowidth[1][0pt]{%
  \leavevmode
  \hbox to #1{\leaders\hbox to \answerdotsep{\hss{\color{gray!85}.}\hss}\hskip 0pt plus 1fill}%
}%

\newcommand\answerlinetoeol{%
  \leavevmode
  \leaders\hbox to \answerdotsep{\hss{\color{gray!85}.}\hss}\hskip 0pt plus 1fill\strut
}%

\newcommand\answerdotsep{6pt}%
%---------------------------------------------------------
%------------------    -----------    --------------------
%-----\cdotsx{nombre_de_points} mode maths ----------------
\newcommand*{\cdotsx}[1][6]{%
  \mathinner{\mskip 3mu \PfM@cdotsx@repeat{#1}\mskip 3mu}%
}%

\newcommand*{\PfM@cdotsx@repeat}[1]{%
  \ifnum#1>0
    \foreach \PfMi in {1,...,#1}{%
      \color{gray!85!black}\ldotp\kern 1pt\mathpunct{}%
    }%
  \fi
}%

%----------------------------------------------------------
  %-----------anserline[5]----------------------------------      
        \newcommand{\anserline}[1][1]{%
        \def\xhrulefill{\leavevmode\leaders\hrule height 0.5pt \hfill\kern 0pt}
    \foreach \n in {1,...,#1}{%
        {\color{gray!85}\xhrulefill\par\vspace{1em}}}}%
        
%--------------------------------------------------
%\anspage{1} ajouter une seul page%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\anserpage}[1][25]{%
	\newpage
	 \begin{center}
            \begin{tcolorbox}[enhanced,colback=white,colframe=black]
            {\begin{center}\large \textbf{ADDITIONAL ANSWER PAGE:} Clearly number each question\end{center}}
            \end{tcolorbox}
        \end{center}
        \vspace{5pt}
    \foreach \n in {1,...,#1}{%
        \vspace{5pt}
        \anserdotline
         }}%
%----------------------------------------------
%---------- \tr[3] une ligne de réponse -------------------
\newcommand{\tr}[1][5]{
\textcolor{gray}{\rule[-1pt]{\fpeval{#1}em}{0.5pt}}%
}
