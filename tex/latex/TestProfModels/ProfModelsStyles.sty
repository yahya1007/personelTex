  %-------Style Maquette DS -------------------------------
\newcommand\TikzDevS{%
  \clearpage
  \begin{tcolorbox}[colback=gray!5,%
    enhanced,%
    overlay unbroken and first={%
      \node[yshift=1em] at (frame.south) {\scriptsize\sffamily-- Calculatrice \ifboolKV[DS]{Calculatrice}{autorisée}{interdite} --};
    }
    ]%
    \sffamily Devoir surveillé N\textsuperscript{\underline{o}}\useKV[DS]{Numero} (Sujet \useKV[DS]{Sujet})\hfill\useKV[DS]{Niveau}.A.C \useKV[DS]{Classe}
    \par{\tiny\useKV[DS]{Code}}\hfill{\scriptsize\useKV[DS]{Date}}
  \end{tcolorbox}%
}%
%-------------Style Maquette DevS ----------------
\newcommand\TikzDS{%
