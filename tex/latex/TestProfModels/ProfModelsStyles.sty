\tcbitem[coltitle=black, enhanced jigsaw,colback=white, boxrule=2pt,halign=left,left=2pt]
        \begin{large}\textbf{N°:}\end{large}
\end{tcbitemize}
\tcbitem[enhanced jigsaw, fontupper=\bfseries,raster multirow=2,raster multicolumn=2, raster height=\tcbtextheight,colback=white, boxrule=2pt, segmentation style={solid,gray!50!black,line width=2pt},
finish={\draw[gray!50!black,line width=2pt] 
([xshift=-2pt,yshift=1pt]frame.25) -- ([xshift=0pt,yshift=1pt]frame.south);
