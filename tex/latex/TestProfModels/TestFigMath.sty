% --------------------------------------------------------------
% \trapeze[angle][labels]{grande_base}{petite_base}{hauteur}[nom_centre]
% angle = angle en A entre la grande base et le côté oblique AD
% --------------------------------------------------------------
\NewDocumentCommand{\trapeze}{ O{} O{} m m m O{} O{} }{%
  \begingroup
    \figsetdefault{#1}{70}{\figAngle}%
    \figsetdefault{#2}{A,B,C,D}{\figLbls}%
    \def\figBase{#3}%
    \def\figPetiteBase{#4}%
    \def\figH{#5}%
    \pgfmathsetmacro{\figAD}{\figH/sin(\figAngle)}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefShiftPoint[\figPtA](\figAngle:\figAD){\figPtD}
    \tkzDefShiftPoint[\figPtD](\figPetiteBase,0){\figPtC}

    \FigQuadrilatere{\figPtA}{\figPtB}{\figPtC}{\figPtD}{#6}{below}[#7]
  \endgroup
}%
%==============================================================
% --------------------------------------------------------------
% \Triangle[angleA][labels]{base}{angleB}
% \Triangle*[angleA][labels]{base}{angleB}
% --------------------------------------------------------------
\NewDocumentCommand{\Triangle}{ s O{} O{} m m O{} }{%
  \begingroup
    \figsetdefault{#2}{60}{\figAngleA}%
    \figsetdefault{#3}{A,B,C,H}{\figLbls}%
    \edef\figTriLabelsForPos{\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3}}%
    \figposresolve{below,below,above}{\figTriLabelsForPos}{#6}{\figTriPos}%
    \def\figBase{#4}%
    \def\figAngleB{#5}%
    \pgfmathsetmacro{\figAngleC}{180-\figAngleA-\figAngleB}%

    % noms de points calculés une seule fois
    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtH{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefTriangle[two angles={\figAngleA} and {\figAngleB}](\figPtA,\figPtB)
    \tkzGetPoint{\figPtC}

    \tkzDrawPolygon(\figPtA,\figPtB,\figPtC)

    \IfBooleanT{#1}{%
      \pgfmathparse{abs(\figAngleA-90)<0.01}%
      \ifdim\pgfmathresult pt>0.5pt
        \tkzDefPointBy[projection= onto \figPtB --\figPtC](\figPtA)
        \tkzGetPoint{\figPtH}
        \tkzDrawSegment[dashed](\figPtA,\figPtH)
        \tkzMarkRightAngle(\figPtA,\figPtH,\figPtB)
        \tkzDrawPoint(\figPtH)
        \tkzLabelPoint[above right](\figPtH){\figPtH}
      \else
        \pgfmathparse{abs(\figAngleB-90)<0.01}%
        \ifdim\pgfmathresult pt>0.5pt
          \tkzDefPointBy[projection= onto \figPtA --\figPtC](\figPtB)
          \tkzGetPoint{\figPtH}
          \tkzDrawSegment[dashed](\figPtB,\figPtH)
          \tkzMarkRightAngle(\figPtB,\figPtH,\figPtA)
          \tkzDrawPoint(\figPtH)
          \tkzLabelPoint[above left](\figPtH){\figPtH}
        \else
          \pgfmathparse{abs(\figAngleC-90)<0.01}%
          \ifdim\pgfmathresult pt>0.5pt
            \tkzDefPointBy[projection= onto \figPtA --\figPtB](\figPtC)
            \tkzGetPoint{\figPtH}
            \tkzDrawSegment[dashed](\figPtC,\figPtH)
            \tkzMarkRightAngle(\figPtC,\figPtH,\figPtB)
            \tkzDrawPoint(\figPtH)
            \tkzLabelPoint[below](\figPtH){\figPtH}
          \fi
        \fi
      \fi
    }%

    \tkzLabelPoint[\figlabelitem{\figTriPos}{1}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figTriPos}{2}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figTriPos}{3}](\figPtC){\figPtC}
  \endgroup
}

% --------------------------------------------------------------
% \cercle[angle][labels]{rayon}
% --------------------------------------------------------------
\NewDocumentCommand{\cercle}{ s O{} O{} m O{} }{%
  \begingroup
    \figsetdefault{#2}{30}{\figAngle}%
    \figsetdefault{#3}{O,A}{\figLbls}%
    \figposresolve{below,above right}{\figLbls}{#5}{\figCerclePos}%
    \def\figR{#4}%

    % Noms de points calculés une seule fois
    \edef\figPtO{\figlabelitem{\figLbls}{1}}%
    \edef\figPtA{\figlabelitem{\figLbls}{2}}%

    \tkzDefPoint(0,0){\figPtO}
    \tkzDefShiftPoint[\figPtO](\figAngle:\figR){\figPtA}

    \tkzDrawCircle(\figPtO,\figPtA)
    \tkzDrawPoint(\figPtO)
    \IfBooleanT{#1}{%
      \tkzDrawSegment(\figPtO,\figPtA)
      \tkzDrawPoint(\figPtA)
      \tkzLabelPoint[\figlabelitem{\figCerclePos}{2}](\figPtA){\figPtA}
    }%
    \tkzLabelPoint[\figlabelitem{\figCerclePos}{1}](\figPtO){\figPtO}%
  \endgroup
}
%==============================================================
% --------------------------------------------------------------
% \thales*[angle][labels]{angleSecantes}{dist1}{dist2}
% --------------------------------------------------------------
% *        : version "papillon" (O entre les deux parallèles)
% #1 (opt) : rotation globale en degrés (défaut 0)
% #2 (opt) : liste des labels, par défaut O,A,B,C,D
% #3       : angle entre les deux sécantes (défaut 40)
% #4       : distance O -- première parallèle
% #5       : distance O -- deuxième parallèle
% --------------------------------------------------------------
\NewDocumentCommand{\thales}{ s O{} O{} m m m O{} }{%
  \begingroup
    \figsetdefault{#2}{0}{\figAngle}%
    \figsetdefault{#3}{O,A,B,C,D}{\figLbls}%
    \IfBooleanTF{#1}
      {\figposresolve{above left,below,above,above left,below right}{\figLbls}{#7}{\figThalesPos}}%
      {\figposresolve{above left,below,below,above left,above left}{\figLbls}{#7}{\figThalesPos}}%
    \def\figSecAngle{#4}%
    \def\figDistA{#5}%
    \def\figDistB{#6}%

    % Noms de points calculés une seule fois
    \edef\figPtO{\figlabelitem{\figLbls}{1}}%
    \edef\figPtA{\figlabelitem{\figLbls}{2}}%
    \edef\figPtB{\figlabelitem{\figLbls}{3}}%
    \edef\figPtC{\figlabelitem{\figLbls}{4}}%
    \edef\figPtD{\figlabelitem{\figLbls}{5}}%

    % Sommet O
    \tkzDefPoint(0,0){\figPtO}

    % Angle de la deuxième sécante
    \pgfmathsetmacro{\figAngleB}{\figAngle+\figSecAngle}%

    \IfBooleanTF{#1}
      {% --- Configuration papillon : O entre les deux parallèles ---
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistA){\figPtA}
        \tkzDefShiftPoint[\figPtO](\figAngle:-\figDistB){\figPtB}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistA){\figPtC}
        \tkzDefShiftPoint[\figPtO](\figAngleB:-\figDistB){\figPtD}
        % Sécantes prolongées ----------------------------
        \tkzDrawLine[add=0.1 and 0.1](\figPtA,\figPtB)
        \tkzDrawLine[add=0.1 and 0.1](\figPtC,\figPtD)
      }
      {% --- Configuration standard : O au-delà des parallèles ---
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistA){\figPtA}
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistB){\figPtB}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistA){\figPtC}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistB){\figPtD}
        % Sécantes prolongées ---------------------
        \tkzDrawLine[add=0.1 and 0.1](\figPtO,\figPtB)
        \tkzDrawLine[add=0.1 and 0.1](\figPtO,\figPtD)
      }%

    % Parallèles
    \tkzDrawSegment(\figPtA,\figPtC)
    \tkzDrawSegment(\figPtB,\figPtD)

    % Points
    \tkzDrawPoints(\figPtO,\figPtA,\figPtB,\figPtC,\figPtD)

    % Labels
    \tkzLabelPoint[\figlabelitem{\figThalesPos}{1}](\figPtO){\figPtO}
    \tkzLabelPoint[\figlabelitem{\figThalesPos}{2}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figThalesPos}{3}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figThalesPos}{4}](\figPtC){\figPtC}
    \tkzLabelPoint[\figlabelitem{\figThalesPos}{5}](\figPtD){\figPtD}
  \endgroup
}%
%============================================================
% --------------------------------------------------------------
% \parallelesSecante*[angle][labels]{distance}{demi-longueur}
% angle          = angle de la sécante par rapport à l'horizontale (défaut 60°)
% labels         = 6 noms : A,B (droite 1) C,D (droite 2) M,N (intersections)
% distance       = écart vertical entre les deux parallèles
% demi-longueur  = longueur de chaque côté du point d'intersection sur chaque droite
% *              = fait apparaître le marquage des angles alternes-internes en M et N
% --------------------------------------------------------------
\NewDocumentCommand{\parallelesSecante}{ s O{} O{} m m O{} }{%
  \begingroup
    \figsetdefault{#2}{60}{\figAngle}%
    \figsetdefault{#3}{A,B,C,D,M,N}{\figLbls}%
    \figposresolve{below,below,above,above,below right,above left}{\figLbls}{#6}{\figParSecPos}%
    \def\figH{#4}%
    \def\figL{#5}%
    \pgfmathsetmacro{\figDist}{\figH/sin(\figAngle)}%

    % noms de points calculés une seule fois
    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtM{\figlabelitem{\figLbls}{5}}%
    \edef\figPtN{\figlabelitem{\figLbls}{6}}%

    % --- Points d'intersection sécante / parallèles ---
    \tkzDefPoint(0,0){\figPtM}
    \tkzDefShiftPoint[\figPtM](\figAngle:\figDist){\figPtN}

    % --- Extrémités des deux parallèles ---
    \tkzDefShiftPoint[\figPtM](180:\figL){\figPtA}
    \tkzDefShiftPoint[\figPtM](0:\figL){\figPtB}
    \tkzDefShiftPoint[\figPtN](180:\figL){\figPtC}
    \tkzDefShiftPoint[\figPtN](0:\figL){\figPtD}

    % --- Tracés ---
    \tkzDrawLine[add=0.1 and 0.1](\figPtA,\figPtB)
    \tkzDrawLine[add=0.1 and 0.1](\figPtC,\figPtD)
    \tkzDrawLine[add=0.3 and 0.3](\figPtM,\figPtN)

    \tkzDrawPoints(\figPtA,\figPtB,\figPtC,\figPtD,\figPtM,\figPtN)

    \tkzLabelPoint[\figlabelitem{\figParSecPos}{1}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figParSecPos}{2}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figParSecPos}{3}](\figPtC){\figPtC}
    \tkzLabelPoint[\figlabelitem{\figParSecPos}{4}](\figPtD){\figPtD}
    \tkzLabelPoint[\figlabelitem{\figParSecPos}{5}](\figPtM){\figPtM}
    \tkzLabelPoint[\figlabelitem{\figParSecPos}{6}](\figPtN){\figPtN}

    % --- Marquage optionnel : angles alternes-internes ---
    \IfBooleanT{#1}{%
      \tkzMarkAngle[size=0.3,mark=|](\figPtB,\figPtM,\figPtN)
      \tkzMarkAngle[size=0.3,mark=|](\figPtC,\figPtN,\figPtM)
    }%
  \endgroup
}%
