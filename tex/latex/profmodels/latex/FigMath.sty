%==============================================================
% --------------------------------------------------------------
% \thales*[angle][labels]{angleSecantes}{dist1}{dist2}
% --------------------------------------------------------------
% *        : version "papillon" (O entre les deux parallèles)
% #1 (opt) : rotation globale en degrés (défaut 0)
% #2 (opt) : liste des labels, par défaut O,A,B,C,D
% #3       : angle entre les deux sécantes (défaut 40)
% #4       : distance O -- première parallèle
% #5       : distance O -- deuxième parallèle
% --------------------------------------------------------------
\NewDocumentCommand{\thales}{ s O{} O{} m m m }{%
  \begingroup
    \figsetdefault{#2}{0}{\figAngle}%
    \figsetdefault{#3}{O,A,B,C,D}{\figLbls}%
    \def\figSecAngle{#4}%
    \def\figDistA{#5}%
    \def\figDistB{#6}%

    % Noms de points calculés une seule fois
    \edef\figPtO{\figlabelitem{\figLbls}{1}}%
    \edef\figPtA{\figlabelitem{\figLbls}{2}}%
    \edef\figPtB{\figlabelitem{\figLbls}{3}}%
    \edef\figPtC{\figlabelitem{\figLbls}{4}}%
    \edef\figPtD{\figlabelitem{\figLbls}{5}}%

    % Sommet O
    \tkzDefPoint(0,0){\figPtO}

    % Angle de la deuxième sécante
    \pgfmathsetmacro{\figAngleB}{\figAngle+\figSecAngle}%

    \IfBooleanTF{#1}
      {% --- Configuration papillon : O entre les deux parallèles ---
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistA){\figPtA}
        \tkzDefShiftPoint[\figPtO](\figAngle:-\figDistB){\figPtB}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistA){\figPtC}
        \tkzDefShiftPoint[\figPtO](\figAngleB:-\figDistB){\figPtD}
        % Sécantes prolongées ----------------------------
        \tkzDrawLine[add=0.1 and 0.1](\figPtA,\figPtB)
        \tkzDrawLine[add=0.1 and 0.1](\figPtC,\figPtD)
        % Labels -----------------------------------
        \tkzLabelPoint[above](\figPtB){\figPtB}
        \tkzLabelPoint[below right](\figPtD){\figPtD}
      }
      {% --- Configuration standard : O au-delà des parallèles ---
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistA){\figPtA}
        \tkzDefShiftPoint[\figPtO](\figAngle:\figDistB){\figPtB}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistA){\figPtC}
        \tkzDefShiftPoint[\figPtO](\figAngleB:\figDistB){\figPtD}
        % Sécantes prolongées ---------------------
        \tkzDrawLine[add=0.1 and 0.1](\figPtO,\figPtB)
        \tkzDrawLine[add=0.1 and 0.1](\figPtO,\figPtD)
        % Labels --------------------------------
        \tkzLabelPoint[below](\figPtB){\figPtB}
        \tkzLabelPoint[above left](\figPtD){\figPtD}
