%----------------------------------------------------------
%%    		 style0 	 %%%%%%%%%%%%%%%%%%
\tcbset{%
  style0/.style={%
    attach boxed title to top left={xshift=0.2mm},
    boxed title size=standard,
    boxed title style={%
      empty,
      rounded corners=north, 
      boxrule=0pt,
      bottom=0pt
    },
    underlay boxed title={%
      \filldraw[rounded corners, gray!85, line width=.5mm]
      (title.south east)--++(90:\tcboxedtitleheight)--++(183:\tcboxedtitlewidth)--++(-90:\tcboxedtitleheight)|-cycle;
    }%
  }%
}%
 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 		    style1  		%%%%%%%%%%%%%
\tcbset{style1/.style={%
		 %enhanced, 
       % breakable,
        sharp corners,
        rounded corners=northwest,
        %colback=white,
       % colframe=gray!90!black,
        %fonttitle=\bfseries\large\sffamily,
        frame hidden,
        attach boxed title to top left,
        boxed title size=standard,
         boxed title style={%
                empty,
                rounded corners=north, 
                boxrule=0pt,
                bottom=0pt},
                underlay boxed title={%
                \fill[rounded corners=\kvtcb@arc,black,fill=gray!40!white, line width=.5mm]
                    (title.south east)--++(93:\tcboxedtitleheight)--++(183:\tcboxedtitlewidth)--++(-87:\tcboxedtitleheight)|-cycle;
                \draw[tcbcolframe, line width=.5mm] (title.south west)|-(frame.north east);
                }}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 		     style2  		%%%%%%%%%             
\tcbset{style2/.style={
 %breakable,
  %enhanced,
  %colback=white,
  boxrule=0pt,
  arc=0pt,
  outer arc=0pt,
  title style={gray!30!white},
  overlay={
    \draw[line width=1.5pt] (frame.south west) -- (frame.south east);
  }
}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%	           style3		%%%%%%%%%%%%%%%%%
\tcbset{
    style3/.style={%
        %enhanced, 
       % breakable,
       % colback=white,
        %colframe=gray!40!white,
        attach boxed title to top left={yshift*=-\tcboxedtitleheight}, 
        boxed title size=title,
        boxed title style={%
            sharp corners, 
            rounded corners=northwest, 
            colback=tcbcolframe, 
            boxrule=0pt,
        },
        underlay boxed title={%
            \path[fill=tcbcolframe] (title.south west)--(title.south east) 
                to[out=0, in=180] ([xshift=5mm]title.east)--
                (title.center-|frame.east)
                [rounded corners=\kvtcb@arc] |- 
                (frame.north) -| cycle; }}}              
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%                 style4    		%%%%%%
 \tcbset{style4/.style={
 %enhanced,
before skip=2mm,after skip=2mm,
%colback=white,colframe=black,
boxrule=0.4mm,
attach boxed title to top left={xshift=1cm,yshift*=1mm-\tcboxedtitleheight},
boxed title style={frame code={
\draw[fill=tcbcolback!90!gray]
([yshift=-1mm,xshift=-1mm]frame.north west)
arc[start angle=0,end angle=180,radius=1mm]
([yshift=-1mm,xshift=1mm]frame.north east)
arc[start angle=180,end angle=0,radius=1mm];
\draw[left color=tcbcolback!95!gray,right color=tcbcolback!95!gray,
middle color=white]
([xshift=-2mm]frame.north west) -- ([xshift=2mm]frame.north east)
[rounded corners=1mm]-- ([xshift=1mm,yshift=-1mm]frame.north east)
-- (frame.south east) -- (frame.south west)
-- ([xshift=-1mm,yshift=-1mm]frame.north west)
[sharp corners]-- cycle;
},interior engine=empty,
}}} 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%    		  style5   		%%%%%%%%
\tcbset{style5/.style={
%enhanced,
skin=enhancedlast jigsaw,
attach boxed title to top left={xshift=-4mm,yshift=-0.5mm},
colbacktitle=gray!40!white,%colframe=black,
interior style={top color=white,bottom color=white},
boxed title style={empty,arc=0pt,outer arc=0pt,boxrule=0pt},
underlay boxed title={
\filldraw[gray!40!white] (title.north west) -- (title.north east)
-- +(\tcboxedtitleheight-1mm,-\tcboxedtitleheight+1mm)
-- ([xshift=4mm,yshift=0.5mm]frame.north east) -- +(0mm,-1mm)
-- (title.south west) -- cycle;
\filldraw[blue!45!white!50!black] ([yshift=-0.5mm]frame.north west)
-- +(-0.4,0) -- +(0,-0.3) -- cycle;
\fill[blue!45!white!50!black] ([yshift=-0.5mm]frame.north east)
-- +(0,-0.3) -- +(0.4,0) -- cycle; }}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
