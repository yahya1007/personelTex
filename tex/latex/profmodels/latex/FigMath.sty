% --------------------------------------------------------------
% \cylindre[arc][prefixe]{rayon}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cylindre}{ O{} O{} m m }{%
  \figsetdefault{#1}{0.5}{\figArc}%
  \figsetdefault{#2}{O}{\figLbls}%
  \def\figR{#3}%
  \def\figH{#4}%
  % --- \figBase, \figR et \figArc sont VOLONTAIREMENT globales : ---
  % --- \cylpoint en a besoin lors d'un appel ultérieur.        ---
  \edef\figBase{\figlabelitem{\figLbls}{1}}%

  % --- Centres ---
  \tkzDefPoint(0,0){\figBase}
  \tkzDefShiftPoint[\figBase](0,\figH){\figBase h}

  % --- Points gauche / droite (bas et haut) ---
  \tkzDefPoint(\figR,0){\figBase D}
  \tkzDefPoint(-\figR,0){\figBase G}
  \tkzDefShiftPoint[\figBase D](0,\figH){\figBase Dh}
  \tkzDefShiftPoint[\figBase G](0,\figH){\figBase Gh}

  % --- Points avant / arrière (bas et haut) ---
  \tkzDefPoint(0,-\figArc){\figBase Av}
  \tkzDefPoint(0,\figArc){\figBase Ar}
  \tkzDefShiftPoint[\figBase Av](0,\figH){\figBase Avh}
  \tkzDefShiftPoint[\figBase Ar](0,\figH){\figBase Arh}

  % --- Génératrices verticales ---
  \tkzDrawSegments[thick](\figBase G,\figBase Gh \figBase D,\figBase Dh)

  % --- Cercle du haut (entièrement visible) ---
  \tkzDrawEllipse[thick](\figBase h,\figR cm,\figArc cm,0)

  % --- Cercle du bas : moitié cachée ---
  \begin{scope}
    \clip (-\figR-0.1,0) rectangle (\figR+0.1,\figArc+0.1);
    \tkzDrawEllipse[dashed](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  % --- Cercle du bas : moitié visible ---
  \begin{scope}
    \clip (-\figR-0.1,-\figArc-0.1) rectangle (\figR+0.1,0);
    \tkzDrawEllipse[thick](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  \tkzDrawPoint(\figBase)
  \tkzLabelPoint[below](\figBase){\figBase}
}

% --------------------------------------------------------------
% \cylpoint{angle}{bas|haut}{nom}
% Place un point sur le contour elliptique à l'angle donné (°),
% à appeler juste après \cylindre, dans la même tikzpicture.
%  \cylindre[0.5]{2}{4}
%  \foreach \pt in {O,Oh,OD,OG,ODh,OGh,OAv,OAr,OAvh,OArh}{
%    \tkzDrawPoint[red](\pt)
%    \tkzLabelPoint[above right](\pt){\tiny\pt}
%  }
% --------------------------------------------------------------
\ExplSyntaxOn
\NewDocumentCommand{\cylpoint}{ m m m }
  {
    \cs_if_exist:NTF \figBase
      {
        \group_begin:
          \pgfmathsetmacro{\figPX}{\figR*cos(#1)}
          \pgfmathsetmacro{\figPY}{\figArc*sin(#1)}
          \str_if_eq:eeTF {#2} {haut}
            { \tkzDefShiftPoint[\figBase h](\figPX,\figPY){#3} }
            { \tkzDefShiftPoint[\figBase](\figPX,\figPY){#3} }
        \group_end:
      }
      { \PackageError{cylindre}{\string\cylpoint~utilisé~sans~\string\cylindre~préalable}{Appelez~\string\cylindre~avant~\string\cylpoint~dans~la~même~figure.} }
  }
\ExplSyntaxOff
% --------------------------------------------------------------
% \cube[angle][labels]{longueur}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cube}{ O{} O{} m m }{%
  \begingroup
    \figsetdefault{#1}{50}{\figAngle}%
    \figsetdefault{#2}{A,B,C,D,E,F,G,H}{\figLbls}%
    \def\figL{#3}%
    \def\figH{#4}%
    \pgfmathsetmacro{\figHalfL}{0.5*(#3)}%
    \pgfmathsetmacro{\figNegL}{-1*(#3)}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtE{\figlabelitem{\figLbls}{5}}%
    \edef\figPtF{\figlabelitem{\figLbls}{6}}%
    \edef\figPtG{\figlabelitem{\figLbls}{7}}%
    \edef\figPtH{\figlabelitem{\figLbls}{8}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figL,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figHalfL){\figPtC}
    \tkzDefShiftPoint[\figPtC](\figNegL,0){\figPtD}
    \tkzDefShiftPoint[\figPtA](0,\figH){\figPtE}
    \tkzDefShiftPoint[\figPtB](0,\figH){\figPtF}
    \tkzDefShiftPoint[\figPtC](0,\figH){\figPtG}
    \tkzDefShiftPoint[\figPtD](0,\figH){\figPtH}

    \pgfmathparse{\figAngle < 90}
    \ifdim\pgfmathresult pt>0.5pt
      \tkzDrawSegment(\figPtA,\figPtB)
      \tkzDrawSegment(\figPtB,\figPtF)
      \tkzDrawSegment(\figPtF,\figPtE)
      \tkzDrawSegment(\figPtE,\figPtA)
      \tkzDrawSegment(\figPtE,\figPtH)
      \tkzDrawSegment(\figPtH,\figPtG)
      \tkzDrawSegment(\figPtG,\figPtF)
      \tkzDrawSegment(\figPtB,\figPtC)
      \tkzDrawSegment(\figPtC,\figPtG)
      \tkzDrawSegment[dashed](\figPtH,\figPtD)
      \tkzDrawSegment[dashed](\figPtA,\figPtD)
      \tkzDrawSegment[dashed](\figPtD,\figPtC)
    \else
      \tkzDrawSegment(\figPtA,\figPtB)
      \tkzDrawSegment(\figPtF,\figPtE)
      \tkzDrawSegment(\figPtB,\figPtF)
      \tkzDrawSegment(\figPtF,\figPtG)
      \tkzDrawSegment(\figPtD,\figPtA)
      \tkzDrawSegment(\figPtG,\figPtH)
      \tkzDrawSegment(\figPtD,\figPtH)
      \tkzDrawSegment(\figPtA,\figPtE)
      \tkzDrawSegment(\figPtH,\figPtE)
      \tkzDrawSegment[dashed](\figPtG,\figPtC)
      \tkzDrawSegment[dashed](\figPtD,\figPtC)
      \tkzDrawSegment[dashed](\figPtC,\figPtB)
    \fi

    \tkzLabelPoint[below](\figPtA){\figPtA}
    \tkzLabelPoint[below](\figPtB){\figPtB}
    \tkzLabelPoint[below](\figPtC){\figPtC}
    \tkzLabelPoint[below](\figPtD){\figPtD}
    \tkzLabelPoint[above](\figPtE){\figPtE}
    \tkzLabelPoint[above](\figPtF){\figPtF}
    \tkzLabelPoint[above](\figPtG){\figPtG}
    \tkzLabelPoint[above](\figPtH){\figPtH}
  \endgroup
}

% --------------------------------------------------------------
% \prisme[angle][labels]{base}{hauteur}{angle1}{angle2}
% --------------------------------------------------------------
\NewDocumentCommand{\prisme}{ O{} O{} m m m m }{%
  \begingroup
    \figsetdefault{#1}{25}{\figAngle}%
    \figsetdefault{#2}{A,B,C,E,F,G}{\figLbls}%
    \def\figBase{#3}%
    \def\figH{#4}%
    \def\figAngA{#5}%
    \def\figAngB{#6}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtE{\figlabelitem{\figLbls}{5}}%
    \edef\figPtF{\figlabelitem{\figLbls}{6}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefTriangle[two angles={\figAngA} and {\figAngB}](\figPtA,\figPtB)
    \tkzGetPoint{\figPtC}

    \tkzDefShiftPoint[\figPtA](\figAngle:\figH){\figPtD}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figH){\figPtE}
    \tkzDefShiftPoint[\figPtC](\figAngle:\figH){\figPtF}

    \tkzDrawSegment(\figPtA,\figPtB)
    \tkzDrawSegment(\figPtB,\figPtC)
    \tkzDrawSegment(\figPtC,\figPtA)
    \tkzDrawSegment(\figPtB,\figPtE)
    \tkzDrawSegment(\figPtC,\figPtF)
    \tkzDrawSegment(\figPtE,\figPtF)
    \tkzDrawSegment[dashed](\figPtA,\figPtD)
    \tkzDrawSegment[dashed](\figPtD,\figPtF)
    \tkzDrawSegment[dashed](\figPtD,\figPtE)

    \tkzLabelPoint[below left](\figPtA){\figPtA}
    \tkzLabelPoint[below right](\figPtB){\figPtB}
    \tkzLabelPoint[above](\figPtC){\figPtC}
    \tkzLabelPoint[left](\figPtD){\figPtD}
    \tkzLabelPoint[right](\figPtE){\figPtE}
    \tkzLabelPoint[above](\figPtF){\figPtF}
  \endgroup
}

% --------------------------------------------------------------
% \pyramide[angle][labels]{base}{angleSommet1}{angleSommet2}
% --------------------------------------------------------------
\NewDocumentCommand{\pyramide}{ O{} O{} m m m }{%
  \begingroup
    \figsetdefault{#1}{30}{\figAngle}%
    \figsetdefault{#2}{A,B,C,D,S}{\figLbls}%
    \def\figBase{#3}%
    \pgfmathsetmacro{\figProf}{0.75*(#3)}%
    \def\figSomA{#4}%
    \def\figSomB{#5}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtS{\figlabelitem{\figLbls}{5}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figProf){\figPtC}
    \tkzDefShiftPoint[\figPtA](\figAngle:\figProf){\figPtD}
    \tkzDefTriangle[two angles={\figSomA} and {\figSomB}](\figPtA,\figPtB)
    \tkzGetPoint{\figPtS}

    \tkzDrawSegment(\figPtA,\figPtB)
    \tkzDrawSegment(\figPtB,\figPtC)
    \tkzDrawSegment(\figPtC,\figPtS)
    \tkzDrawSegment(\figPtS,\figPtB)
    \tkzDrawSegment(\figPtS,\figPtA)
    \tkzDrawSegment[dashed](\figPtA,\figPtD)
    \tkzDrawSegment[dashed](\figPtS,\figPtD)
    \tkzDrawSegment[dashed](\figPtD,\figPtC)

    \tkzLabelPoint[below left](\figPtA){\figPtA}
    \tkzLabelPoint[below right](\figPtB){\figPtB}
    \tkzLabelPoint[right](\figPtC){\figPtC}
    \tkzLabelPoint[above left](\figPtD){\figPtD}
    \tkzLabelPoint[above](\figPtS){\figPtS}
  \endgroup
}

