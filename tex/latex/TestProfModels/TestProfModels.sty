% Utilise pgfmath (déjà chargé via tikz) pour le tirage.
% Chaque id tiré est marqué via une macro \csname (mécanisme noyau LaTeX,
% \@ifundefined), ce qui évite toute dépendance à un format de liste externe.

\newif\ifPfMSelectionActive
\PfMSelectionActivefalse
\newif\ifPfMAfficherExo
\newif\ifPfMTirageFige% le tirage a-t-il été figé par \FixerTirageExo ?
\PfMTirageFigefalse
\newcounter{PfMTirage}% numéro du tirage en cours (permet plusieurs \ChoisirExercices)
\newcommand\PfMListeChoisis{}% liste (texte, pour affichage/debug uniquement)
\newsavebox\PfMExoPoubelle % boîte "poubelle" pour les exercices non tirés

% \FixerTirageExo{N} : fige le tirage aléatoire.
% INDISPENSABLE dès que le document utilise le barème (\brm), \NoteFinale,
% ou tout \label/\ref : la compilation LaTeX se fait en plusieurs passes, et
% sans seed fixe, \ChoisirExercices tire des exercices DIFFÉRENTS à chaque
% passe (le générateur aléatoire se base sur l'heure de compilation), ce qui
% désynchronise les données lues/écrites dans le fichier .aux entre les
% passes (erreurs du type "Number name `totalX-Y' is undefined").
\newcommand\FixerTirageExo[1]{\pgfmathsetseed{#1}\PfMTirageFigetrue}

% \ChoisirExercices{nb à tirer}[nb total d'exercices]
% Tire "nb à tirer" identifiants distincts parmi 1..nb total.
% Doit être appelé AVANT les \begin{exercice}[Id=...] concernés,
% typiquement juste après \begin{Maquette}{...}.
%
% Le second argument (nb total) est maintenant OPTIONNEL :
% - si omis, il est récupéré automatiquement via le label
%   "PfMFinMaquette<N>" posé à la fin de l'environnement Maquette
%   (voir plus bas), grâce au package refcount (\getrefnumber).
% - Comme pour toute info basée sur un \label, cette valeur n'est
%   disponible qu'APRES une première compilation complète du document
%   (mécanisme standard \ref / \newlabel). Au tout premier passage
%   (ou si le .aux est absent), un avertissement est émis et le total
%   est provisoirement pris égal au nombre demandé (#1), le temps de
%   recompiler.
% - Si le second argument est fourni explicitement, il est utilisé tel
%   quel (comportement historique, toujours disponible).
\NewDocumentCommand\ChoisirExercices{mO{}}{%
  \def\PfM@ArgTotal{#2}%
  \ifx\PfM@ArgTotal\@empty
    % Récupération via refcount : retourne 0 si label inconnu
    \edef\PfM@refval{\getrefnumber{PfMFinMaquette\theMaquette}}%
    \edef\PfM@refzero{0}%
    \ifx\PfM@refval\PfM@refzero
      \ifPfMQuiet\else
        \PackageWarning{ProfModels}%
          {Nombre total d'exercices inconnu pour cette Maquette (page \thepage) : ceci est normal lors d'une premiere compilation.
           Utilisation provisoire de #1 exercices en attendant.
           Recompilez pour obtenir le tirage definitif}%
      \fi
      \edef\PfMTotalCalcExo{#1}%
    \else
      \edef\PfMTotalCalcExo{\PfM@refval}%
    \fi
  \else
    \let\PfMTotalCalcExo\PfM@ArgTotal
  \fi
  \ifnum#1>\PfMTotalCalcExo\relax
    \PackageError{ProfModels}%
      {Impossible de choisir #1 exercices parmi \PfMTotalCalcExo}%
      {Le premier argument doit etre inferieur ou egal au nombre total
       d'exercices disponibles dans cette Maquette.}%
  \fi
  \ifPfMTirageFige\else
    \ifPfMStrict
      \PackageError{ProfModels}%
        {Tirage non fige avant \string\ChoisirExercices}%
        {Appelez \string\FixerTirageExo{N} avant \string\ChoisirExercices
         (l'option 'strict' interdit un tirage non reproductible).}%
    \else
      \ifPfMQuiet\else
        \PackageWarning{ProfModels}%
          {Tirage non fige : appelez \string\FixerTirageExo{N} AVANT
           \string\ChoisirExercices.}%
      \fi
    \fi
  \fi
  \stepcounter{PfMTirage}%
  \PfMSelectionActivetrue
  \gdef\PfMListeChoisis{}%
  \foreach \PfMi in {1,...,#1}{%
    \edef\PfMTrouve{0}%
    \whiledo{\PfMTrouve=0}{%
      \pgfmathrandominteger{\PfMChoixExo}{1}{\PfMTotalCalcExo}%
      \@ifundefined{PfMChoisi\thePfMTirage @\PfMChoixExo}%
        {%
          \expandafter\xdef\csname
            PfMChoisi\thePfMTirage @\PfMChoixExo\endcsname{1}%
          \ifx\PfMListeChoisis\@empty
            \xdef\PfMListeChoisis{\PfMChoixExo}%
          \else
            \xdef\PfMListeChoisis{\PfMListeChoisis, \PfMChoixExo}%
          \fi
          \edef\PfMTrouve{1}%
        }%
        {}%
    }%
  }%
}%

% \ListeExercicesChoisis : affiche les ids tirés (pratique pour vérifier / déboguer)
\newcommand\ListeExercicesChoisis{\PfMListeChoisis}
\newcommand\PfM@MotToujours{ok}

% Détermine si l'exercice en cours doit être affiché.
% - Id non précisé (cas normal) -> Id = position de l'exercice dans le fichier
%   (1er \begin{exercice} -> Id=1, le 2e -> Id=2, etc., qu'il soit affiché ou non) :
%   il suffit donc d'appeler \ChoisirExercices{n}{total} puis d'écrire les
%   exercices dans l'ordre, sans jamais préciser Id.
% - Id=toujours -> exercice exempté du tirage, toujours affiché (ex: consignes).
% - Id=<valeur> précisée manuellement -> comportement normal basé sur cette valeur.
% - Pas de tirage en cours (\ChoisirExercices jamais appelé) -> toujours affiché.

\newcommand\PfM@VerifierAffichage{%
  \stepcounter{PfMExoCatalogue}%
  \ifboolKV[ClesExercices]{Print}%
    {%
      \edef\PfMIdCourant{\useKV[ClesExercices]{Id}}%
      \ifx\PfMIdCourant\@empty
        \edef\PfMIdCourant{\thePfMExoCatalogue}%
        \PfM@VerifierAffichageParTirage
      \else
        \ifx\PfMIdCourant\PfM@MotToujours
          \PfMAfficherExotrue
        \else
          \PfM@VerifierAffichageParTirage
        \fi
      \fi
    }%
    {%
      \PfMAfficherExofalse
    }%
}%
\newcommand\PfM@VerifierAffichageParTirage{%
  \ifPfMSelectionActive
    \@ifundefined{PfMChoisi\thePfMTirage @\PfMIdCourant}%
      {\PfMAfficherExofalse}%
      {\PfMAfficherExotrue}%
  \else
    \PfMAfficherExotrue
  \fi
}%
