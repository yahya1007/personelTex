% --------------------------------------------------------------
% \cylindre[arc][prefixe]{rayon}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cylindre}{ O{} O{} m m }{%
  \figsetdefault{#1}{0.5}{\figArc}%
  \figsetdefault{#2}{O}{\figLbls}%
  \def\figR{#3}%
  \def\figH{#4}%

  % nom de base (calculé une seule fois)
  \edef\figBase{\figlabelitem{\figLbls}{1}}%

  % --- Centres ---
  \tkzDefPoint(0,0){\figBase}
  \tkzDefShiftPoint[\figBase](0,\figH){\figBase h}

  % --- Points gauche / droite (bas et haut) ---
  \tkzDefPoint(\figR,0){\figBase D}
  \tkzDefPoint(-\figR,0){\figBase G}
  \tkzDefShiftPoint[\figBase D](0,\figH){\figBase Dh}
  \tkzDefShiftPoint[\figBase G](0,\figH){\figBase Gh}

  % --- Points avant / arrière (bas et haut) — NOUVEAU ---
  \tkzDefPoint(0,-\figArc){\figBase Av}
  \tkzDefPoint(0,\figArc){\figBase Ar}
  \tkzDefShiftPoint[\figBase Av](0,\figH){\figBase Avh}
  \tkzDefShiftPoint[\figBase Ar](0,\figH){\figBase Arh}

  % --- Génératrices verticales ---
  \tkzDrawSegments[thick](\figBase G,\figBase Gh \figBase D,\figBase Dh)

  % --- Cercle du haut (entièrement visible) ---
  \tkzDrawEllipse[thick](\figBase h,\figR cm,\figArc cm,0)

  % --- Cercle du bas : moitié cachée ---
  \begin{scope}
    \clip (-\figR-0.1,0) rectangle (\figR+0.1,\figArc+0.1);
    \tkzDrawEllipse[dashed](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  % --- Cercle du bas : moitié visible ---
  \begin{scope}
    \clip (-\figR-0.1,-\figArc-0.1) rectangle (\figR+0.1,0);
    \tkzDrawEllipse[thick](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  \tkzDrawPoint(\figBase)
  \tkzLabelPoint[below](\figBase){\figBase}
}

% --------------------------------------------------------------
% \cylpoint{angle}{bas|haut}{nom}
% Place un point sur le contour elliptique à l'angle donné (°),
% à appeler juste après \cylindre, dans la même tikzpicture.
%  \cylindre[0.5]{2}{4}
%  \foreach \pt in {O,Oh,OD,OG,ODh,OGh,OAv,OAr,OAvh,OArh}{
%    \tkzDrawPoint[red](\pt)
%    \tkzLabelPoint[above right](\pt){\tiny\pt}
%  }
% --------------------------------------------------------------
\ExplSyntaxOn
\NewDocumentCommand{\cylpoint}{ m m m }
  {
    \pgfmathsetmacro{\figPX}{\figR*cos(#1)}
    \pgfmathsetmacro{\figPY}{\figArc*sin(#1)}
    \str_if_eq:eeTF {#2} {haut}
      { \tkzDefShiftPoint[\figBase h](\figPX,\figPY){#3} }
      { \tkzDefShiftPoint[\figBase](\figPX,\figPY){#3} }
  }
\ExplSyntaxOff

% --------------------------------------------------------------
% \cube[angle][labels]{longueur}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cube}{ O{} O{} m m }{%
  \figsetdefault{#1}{50}{\figAngle}%
  \figsetdefault{#2}{A,B,C,D,E,F,G,H}{\figLbls}%
  \def\figL{#3}%
  \def\figH{#4}%
  \pgfmathsetmacro{\figHalfL}{0.5*(#3)}%
  \pgfmathsetmacro{\figNegL}{-1*(#3)}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figL,0){\figlabelitem{\figLbls}{2}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{2}](\figAngle:\figHalfL){\figlabelitem{\figLbls}{3}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{3}](\figNegL,0){\figlabelitem{\figLbls}{4}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](0,\figH){\figlabelitem{\figLbls}{5}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{2}](0,\figH){\figlabelitem{\figLbls}{6}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{3}](0,\figH){\figlabelitem{\figLbls}{7}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{4}](0,\figH){\figlabelitem{\figLbls}{8}}

  \pgfmathparse{\figAngle < 90}
  \ifdim\pgfmathresult pt>0.5pt
    \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
    \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{6})
    \tkzDrawSegment(\figlabelitem{\figLbls}{6},\figlabelitem{\figLbls}{5})
    \tkzDrawSegment(\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{1})
    \tkzDrawSegment(\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{8})
    \tkzDrawSegment(\figlabelitem{\figLbls}{8},\figlabelitem{\figLbls}{7})
    \tkzDrawSegment(\figlabelitem{\figLbls}{7},\figlabelitem{\figLbls}{6})
    \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3})
    \tkzDrawSegment(\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{7})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{8},\figlabelitem{\figLbls}{4})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{4})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{3})
  \else
    \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
    \tkzDrawSegment(\figlabelitem{\figLbls}{6},\figlabelitem{\figLbls}{5})
    \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{6})
    \tkzDrawSegment(\figlabelitem{\figLbls}{6},\figlabelitem{\figLbls}{7})
    \tkzDrawSegment(\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{1})
    \tkzDrawSegment(\figlabelitem{\figLbls}{7},\figlabelitem{\figLbls}{8})
    \tkzDrawSegment(\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{8})
    \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{5})
    \tkzDrawSegment(\figlabelitem{\figLbls}{8},\figlabelitem{\figLbls}{5})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{7},\figlabelitem{\figLbls}{3})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{3})
    \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{2})
  \fi

  \tkzLabelPoint[below](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{4}){\figlabelitem{\figLbls}{4}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{5}){\figlabelitem{\figLbls}{5}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{6}){\figlabelitem{\figLbls}{6}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{7}){\figlabelitem{\figLbls}{7}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{8}){\figlabelitem{\figLbls}{8}}
}

% --------------------------------------------------------------
% \prisme[angle][labels]{base}{hauteur}{angle1}{angle2}
% --------------------------------------------------------------
\NewDocumentCommand{\prisme}{ O{} O{} m m m m }{%
  \figsetdefault{#1}{25}{\figAngle}%
  \figsetdefault{#2}{A,B,C,E,F,G}{\figLbls}%
  \def\figBase{#3}%
  \def\figH{#4}%
  \def\figAngA{#5}%
  \def\figAngB{#6}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figBase,0){\figlabelitem{\figLbls}{2}}
  \tkzDefTriangle[two angles={\figAngA} and {\figAngB}](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzGetPoint{\figlabelitem{\figLbls}{3}}

  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figH){\figlabelitem{\figLbls}{4}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{2}](\figAngle:\figH){\figlabelitem{\figLbls}{5}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{3}](\figAngle:\figH){\figlabelitem{\figLbls}{6}}

  \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3})
  \tkzDrawSegment(\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{1})
  \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{5})
  \tkzDrawSegment(\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{6})
  \tkzDrawSegment(\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{6})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{4})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{6})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{5})

  \tkzLabelPoint[below left](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[below right](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[left](\figlabelitem{\figLbls}{4}){\figlabelitem{\figLbls}{4}}
  \tkzLabelPoint[right](\figlabelitem{\figLbls}{5}){\figlabelitem{\figLbls}{5}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{6}){\figlabelitem{\figLbls}{6}}
}

% --------------------------------------------------------------
% \pyramide[angle][labels]{base}{angleSommet1}{angleSommet2}
% --------------------------------------------------------------
\NewDocumentCommand{\pyramide}{ O{} O{} m m m }{%
  \figsetdefault{#1}{30}{\figAngle}%
  \figsetdefault{#2}{A,B,C,D,S}{\figLbls}%
  \def\figBase{#3}%
  \pgfmathsetmacro{\figProf}{0.75*(#3)}%
  \def\figSomA{#4}%
  \def\figSomB{#5}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figBase,0){\figlabelitem{\figLbls}{2}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{2}](\figAngle:\figProf){\figlabelitem{\figLbls}{3}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figProf){\figlabelitem{\figLbls}{4}}
  \tkzDefTriangle[two angles={\figSomA} and {\figSomB}](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzGetPoint{\figlabelitem{\figLbls}{5}}

  \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3})
  \tkzDrawSegment(\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{5})
  \tkzDrawSegment(\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{2})
  \tkzDrawSegment(\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{1})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{4})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{5},\figlabelitem{\figLbls}{4})
  \tkzDrawSegment[dashed](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{3})

  \tkzLabelPoint[below left](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[below right](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
  \tkzLabelPoint[right](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[above left](\figlabelitem{\figLbls}{4}){\figlabelitem{\figLbls}{4}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{5}){\figlabelitem{\figLbls}{5}}
}

