%---------- \anserdotline[number lines][distance] mode texte ------

\NewDocumentCommand\anserdotline{O{1}o}{%
  \foreach \PfMn in {1,...,#1}{%
    \IfNoValueTF{#2}%
      {\answerlinetoeol}%
      {\answerlinetowidth[#2]}%
    \par\vspace{10pt}%
  }%
}%

\newcommand\answerlinetowidth[1][0pt]{%
  \leavevmode
  \hbox to #1{\leaders\hbox to \answerdotsep{\hss{\color{gray!85}.}\hss}\hskip 0pt plus 1fill}%
}%

\newcommand\answerlinetoeol{%
  \leavevmode
  \leaders\hbox to \answerdotsep{\hss{\color{gray!85}.}\hss}\hskip 0pt plus 1fill\strut
}%

\newcommand\answerdotsep{6pt}%
