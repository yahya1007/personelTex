    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figCote,0){\figPtB}
    \tkzDefShiftPoint[\figPtA](\figAngle:\figCote){\figPtD}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figCote){\figPtC}

    \FigQuadrilatere{\figPtA}{\figPtB}{\figPtC}{\figPtD}{#4}{below left=2mm and -1mm of #4}[#5]
  \endgroup
}%
