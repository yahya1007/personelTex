% ==============================================================
%                    FIGURES PLANES
% ==============================================================
\ExplSyntaxOn
% --------------------------------------------------------------
\NewDocumentCommand{\FigQuadrilatere}{ m m m m m m O{} }
  {
    \edef\figQLabelsForPos{#1,#2,#3,#4}%
    \figposresolve{below,below,above,above}{\figQLabelsForPos}{#7}{\figQPos}%
    \tkzDrawPolygon(#1,#2,#3,#4)

    \tkzLabelPoint[\figlabelitem{\figQPos}{1}](#1){#1}
    \tkzLabelPoint[\figlabelitem{\figQPos}{2}](#2){#2}
    \tkzLabelPoint[\figlabelitem{\figQPos}{3}](#3){#3}
    \tkzLabelPoint[\figlabelitem{\figQPos}{4}](#4){#4}

    \tl_if_blank:nF {#5}
      {
        \tkzInterLL(#1,#3)(#2,#4)
        \tkzGetPoint{#5}
        \tkzDrawSegment(#1,#3)
        \tkzDrawSegment(#2,#4)
        \tkzDrawPoint(#5)
        \tkzLabelPoint[#6](#5){#5}
      }
  }%
\ExplSyntaxOff
% --------------------------------------------------------------
% \carre[labels]{cote}[nom_centre]
% --------------------------------------------------------------
\NewDocumentCommand{\carre}{ O{} m O{} O{} }{%
  \begingroup
    \figsetdefault{#1}{A,B,C,D}{\figLbls}%
    \def\figC{#2}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figC,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](90:\figC){\figPtC}
    \tkzDefShiftPoint[\figPtA](90:\figC){\figPtD}

    \FigQuadrilatere{\figPtA}{\figPtB}{\figPtC}{\figPtD}{#3}{below}[#4]
  \endgroup
}

