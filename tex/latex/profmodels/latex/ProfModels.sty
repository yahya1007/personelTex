%=====================================================
% PERMUTATION + CHOIX COMPATIBLES
%=====================================================

\ExplSyntaxOn

%------------------------------------------------------
% Variables
%------------------------------------------------------
\bool_new:N  \g__pfm_perm_active_bool
\int_new:N   \g__pfm_perm_count_int     
\int_new:N   \g__pfm_perm_raw_int       
\seq_new:N   \g__pfm_perm_order_seq     
\seq_new:N   \l__pfm_perm_seen_seq     
\tl_new:N    \l__pfm_exo_body_tl    

\cs_new_eq:NN \PfMExerciceOriginal    \scan_stop:
\cs_new_eq:NN \PfMEndExerciceOriginal \scan_stop:

%------------------------------------------------------
% \permuteExercices{3,1,5,2,4}
%   Les indices réfèrent à la POSITION parmi les exercices
%   effectivement retenus (après \ChoisirExercices).
%------------------------------------------------------
\NewDocumentCommand{\permuteExercices}{m}{%
    \seq_gset_split:Nnn \g__pfm_perm_order_seq { , } { #1 }
    \int_gzero:N \g__pfm_perm_count_int
    \int_gzero:N \g__pfm_perm_raw_int
    \bool_gset_true:N \g__pfm_perm_active_bool
	%
    % sauvegarder l'environnement exercice actif
    \cs_gset_eq:NN \PfMExerciceOriginal    \exercice
    \cs_gset_eq:NN \PfMEndExerciceOriginal \endexercice
	%
    % remplacer par la version stockante
    \cs_gset_eq:NN \exercice    \PfMExerciceStocke
    \cs_gset_eq:NN \endexercice \endPfMExerciceStocke
  }%
\let\PermuteExercices\permuteExercices

%------------------------------------------------------
% Environnement interne : stocke chaque exercice,
% en respectant le filtrage de \ChoisirExercices et Print
%------------------------------------------------------
\NewDocumentEnvironment{PfMExerciceStocke}{ O{} +b }{%
    \int_gincr:N \g__pfm_perm_raw_int
   % 
    \useKVdefault[ClesExercices]%
    \setKV[ClesExercices]{#1}%
    \PfM@VerifierAffichage
    %
    \ifPfMAfficherExo
      \int_gincr:N \g__pfm_perm_count_int
      %
      % Nettoyer le corps : supprimer espaces en début/fin
      \tl_set:Nn \l__pfm_exo_body_tl {#2}%
      \tl_trim_spaces:N \l__pfm_exo_body_tl
      \cs_gset_protected:cpx
        { PfMStoredExo@
          \int_use:N \c@Maquette @
          \int_use:N \g__pfm_perm_count_int }
        {%
          \exp_not:N \PfMExerciceOriginal [\exp_not:n{#1}]%
            \exp_not:V \l__pfm_exo_body_tl%
          \exp_not:N \PfMEndExerciceOriginal
        }%
    \fi
  }%
  {}%
%------------------------------------------------------
% Affichage dans l'ordre permuté
%------------------------------------------------------
\cs_new_protected:Npn \PfMAfficherExercicesPermutes{%
    \bool_if:NT \g__pfm_perm_active_bool
      {
        % Restaurer l'environnement AVANT d'afficher
        \cs_gset_eq:NN \exercice    \PfMExerciceOriginal
        \cs_gset_eq:NN \endexercice \PfMEndExerciceOriginal
        % Réinitialiser le compteur d'exercices pour la numérotation
        \setcounter{PfMExo}{0}
        % Réinitialiser le catalogue pour que la vérification
        % à l'intérieur des exercices originaux fonctionne
        \setcounter{PfMExoCatalogue}{0}
        % Désactiver temporairement la sélection pour l'affichage
        % (le filtrage a déjà été fait au stockage)
        \bool_set_false:N \l_tmpa_bool
        \ifPfMSelectionActive
          \bool_set_true:N \l_tmpa_bool
        \fi
        \PfMSelectionActivefalse
        \seq_clear:N \l__pfm_perm_seen_seq
        % --- Afficher dans l'ordre demandé ---
        \seq_map_inline:Nn \g__pfm_perm_order_seq
          {
            \tl_set:Nn \l_tmpa_tl { ##1 }
            \tl_trim_spaces:N \l_tmpa_tl
            % Vérifier les doublons
            \seq_if_in:NVTF \l__pfm_perm_seen_seq \l_tmpa_tl
              {
                \PackageWarning{ProfModels}
                  { Exercice~ \tl_use:N \l_tmpa_tl \c_space_tl
                    demande~ deux~ fois~ dans~
                    \token_to_str:N \permuteExercices }
              }%
              {
\seq_put_right:NV \l__pfm_perm_seen_seq \l_tmpa_tl
              }%
            % Afficher s'il existe
            \cs_if_exist:cTF
              { PfMStoredExo@
                \int_use:N \c@Maquette @
                \tl_use:N \l_tmpa_tl }
              {
                \use:c { PfMStoredExo@
                  \int_use:N \c@Maquette @
                  \tl_use:N \l_tmpa_tl }
              }%
              {%
                \PackageWarning{ProfModels}
                  { Exercice~ \tl_use:N \l_tmpa_tl \c_space_tl
                    inexistant~ (seulement~
      \int_use:N \g__pfm_perm_count_int \c_space_tl
                    exercices~ retenus~ apres~ filtrage) }
              }%
          }%
        % --- Avertir pour les exercices oubliés ---
        \int_step_inline:nn { \g__pfm_perm_count_int }
          {
            \tl_set:Nx \l_tmpb_tl { \int_eval:n {##1} }
            \seq_if_in:NVF \l__pfm_perm_seen_seq \l_tmpb_tl
              {
                \PackageWarning{ProfModels}
{ Exercice~ retenu~ \tl_use:N \l_tmpb_tl \c_space_tl
non~ mentionne~ dans~\token_to_str:N \permuteExercices ;~
                    il~ ne~ sera~ pas~ affiche }%
              }%
          }%
        % Restaurer l'état de sélection
        \bool_if:NT \l_tmpa_bool { \PfMSelectionActivetrue }
        \bool_gset_false:N \g__pfm_perm_active_bool
      }%
  }%

\NewDocumentCommand{\AfficherExercicesPermutes}{}
  { \PfMAfficherExercicesPermutes }

