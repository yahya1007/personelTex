% --------------------------------------------------------------
% \cone*[arc][labels]{rayon}{hauteur}
% * : affiche le tracé du rayon OB
% labels par défaut : O (centre base), S (sommet), A, B (points sur la base)
% --------------------------------------------------------------
\NewDocumentCommand{\cone}{ s O{} O{} m m O{} }{%
  \begingroup
    \figsetdefault{#2}{0.5}{\figArc}%
    \figsetdefault{#3}{O,S,A,B}{\figLbls}%
    \figposresolve{below,above,below,below}{\figLbls}{#6}{\figConePos}%
    \def\figR{#4}%
    \def\figH{#5}%

    \edef\figPtO{\figlabelitem{\figLbls}{1}}%
    \edef\figPtS{\figlabelitem{\figLbls}{2}}%
    \edef\figPtA{\figlabelitem{\figLbls}{3}}%
    \edef\figPtB{\figlabelitem{\figLbls}{4}}%

    \tkzDefPoint(0,0){\figPtO}
    \tkzDefShiftPoint[\figPtO](0,\figH){\figPtS}
    \tkzDefPoint(\figR,0){\figPtB}
    \tkzDefPoint(-\figR,0){\figPtA}

    % --- Génératrices visibles ---
    \tkzDrawSegment(\figPtA,\figPtS)
    \tkzDrawSegment(\figPtB,\figPtS)

    % --- Rayon (base à base), désactivable ---
    \IfBooleanT{#1}{%
      \tkzDrawSegment[dashed](\figPtO,\figPtB)
      \tkzDrawSegment[dashed](\figPtO,\figPtS)
       \tkzDrawPoint(\figPtA)
    \tkzDrawPoint(\figPtB)
    \tkzLabelPoint[\figlabelitem{\figConePos}{3}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figConePos}{4}](\figPtB){\figPtB}
    }%

    % --- Ellipse de base : moitié cachée ---
    \begin{scope}
      \clip (-\figR-0.1,0) rectangle (\figR+0.1,\figArc+0.1);
      \tkzDrawEllipse[dashed](\figPtO,\figR cm,\figArc cm,0)
    \end{scope}

    % --- Ellipse de base : moitié visible ---
    \begin{scope}
      \clip (-\figR-0.1,-\figArc-0.1) rectangle (\figR+0.1,0);
      \tkzDrawEllipse[thick](\figPtO,\figR cm,\figArc cm,0)
    \end{scope}

    \tkzDrawPoint(\figPtO)
    \tkzDrawPoint(\figPtS)
   

    \tkzLabelPoint[\figlabelitem{\figConePos}{1}](\figPtO){\figPtO}
    \tkzLabelPoint[\figlabelitem{\figConePos}{2}](\figPtS){\figPtS}
    
  \endgroup
}
% --------------------------------------------------------------
% \cube[angle][labels]{longueur}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cube}{ O{} O{} m m O{} }{%
  \begingroup
    \figsetdefault{#1}{50}{\figAngle}%
    \figsetdefault{#2}{A,B,C,D,E,F,G,H}{\figLbls}%
    \figposresolve{below,below,below,below,above,above,above,above}{\figLbls}{#5}{\figCubePos}%
    \def\figL{#3}%
    \def\figH{#4}%
    \pgfmathsetmacro{\figHalfL}{0.5*(#3)}%
    \pgfmathsetmacro{\figNegL}{-1*(#3)}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtE{\figlabelitem{\figLbls}{5}}%
    \edef\figPtF{\figlabelitem{\figLbls}{6}}%
    \edef\figPtG{\figlabelitem{\figLbls}{7}}%
    \edef\figPtH{\figlabelitem{\figLbls}{8}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figL,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figHalfL){\figPtC}
    \tkzDefShiftPoint[\figPtC](\figNegL,0){\figPtD}
    \tkzDefShiftPoint[\figPtA](0,\figH){\figPtE}
    \tkzDefShiftPoint[\figPtB](0,\figH){\figPtF}
    \tkzDefShiftPoint[\figPtC](0,\figH){\figPtG}
    \tkzDefShiftPoint[\figPtD](0,\figH){\figPtH}

    \pgfmathparse{\figAngle < 90}
    \ifdim\pgfmathresult pt>0.5pt
      \tkzDrawSegment(\figPtA,\figPtB)
      \tkzDrawSegment(\figPtB,\figPtF)
      \tkzDrawSegment(\figPtF,\figPtE)
      \tkzDrawSegment(\figPtE,\figPtA)
      \tkzDrawSegment(\figPtE,\figPtH)
      \tkzDrawSegment(\figPtH,\figPtG)
      \tkzDrawSegment(\figPtG,\figPtF)
      \tkzDrawSegment(\figPtB,\figPtC)
      \tkzDrawSegment(\figPtC,\figPtG)
      \tkzDrawSegment[dashed](\figPtH,\figPtD)
      \tkzDrawSegment[dashed](\figPtA,\figPtD)
      \tkzDrawSegment[dashed](\figPtD,\figPtC)
    \else
      \tkzDrawSegment(\figPtA,\figPtB)
      \tkzDrawSegment(\figPtF,\figPtE)
      \tkzDrawSegment(\figPtB,\figPtF)
      \tkzDrawSegment(\figPtF,\figPtG)
      \tkzDrawSegment(\figPtD,\figPtA)
      \tkzDrawSegment(\figPtG,\figPtH)
      \tkzDrawSegment(\figPtD,\figPtH)
      \tkzDrawSegment(\figPtA,\figPtE)
      \tkzDrawSegment(\figPtH,\figPtE)
      \tkzDrawSegment[dashed](\figPtG,\figPtC)
      \tkzDrawSegment[dashed](\figPtD,\figPtC)
      \tkzDrawSegment[dashed](\figPtC,\figPtB)
    \fi

    \tkzLabelPoint[\figlabelitem{\figCubePos}{1}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{2}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{3}](\figPtC){\figPtC}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{4}](\figPtD){\figPtD}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{5}](\figPtE){\figPtE}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{6}](\figPtF){\figPtF}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{7}](\figPtG){\figPtG}
    \tkzLabelPoint[\figlabelitem{\figCubePos}{8}](\figPtH){\figPtH}
  \endgroup
}

% --------------------------------------------------------------
% \prisme[angle][labels]{base}{hauteur}{angle1}{angle2}
% --------------------------------------------------------------
\NewDocumentCommand{\prisme}{ O{} O{} m m m m O{} }{%
  \begingroup
    \figsetdefault{#1}{25}{\figAngle}%
    \figsetdefault{#2}{A,B,C,E,F,G}{\figLbls}%
    \figposresolve{below left,below right,above,left,right,above}{\figLbls}{#7}{\figPrismePos}%
    \def\figBase{#3}%
    \def\figH{#4}%
    \def\figAngA{#5}%
    \def\figAngB{#6}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtE{\figlabelitem{\figLbls}{5}}%
    \edef\figPtF{\figlabelitem{\figLbls}{6}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefTriangle[two angles={\figAngA} and {\figAngB}](\figPtA,\figPtB)
    \tkzGetPoint{\figPtC}

    \tkzDefShiftPoint[\figPtA](\figAngle:\figH){\figPtD}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figH){\figPtE}
    \tkzDefShiftPoint[\figPtC](\figAngle:\figH){\figPtF}

    \tkzDrawSegment(\figPtA,\figPtB)
    \tkzDrawSegment(\figPtB,\figPtC)
    \tkzDrawSegment(\figPtC,\figPtA)
    \tkzDrawSegment(\figPtB,\figPtE)
    \tkzDrawSegment(\figPtC,\figPtF)
    \tkzDrawSegment(\figPtE,\figPtF)
    \tkzDrawSegment[dashed](\figPtA,\figPtD)
    \tkzDrawSegment[dashed](\figPtD,\figPtF)
    \tkzDrawSegment[dashed](\figPtD,\figPtE)

    \tkzLabelPoint[\figlabelitem{\figPrismePos}{1}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figPrismePos}{2}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figPrismePos}{3}](\figPtC){\figPtC}
    \tkzLabelPoint[\figlabelitem{\figPrismePos}{4}](\figPtD){\figPtD}
    \tkzLabelPoint[\figlabelitem{\figPrismePos}{5}](\figPtE){\figPtE}
    \tkzLabelPoint[\figlabelitem{\figPrismePos}{6}](\figPtF){\figPtF}
  \endgroup
}

% --------------------------------------------------------------
% \pyramide[angle][labels]{base}{angleSommet1}{angleSommet2}
% --------------------------------------------------------------
\NewDocumentCommand{\pyramide}{ O{} O{} m m m O{} }{%
  \begingroup
    \figsetdefault{#1}{30}{\figAngle}%
    \figsetdefault{#2}{A,B,C,D,S}{\figLbls}%
    \figposresolve{below left,below right,right,above left,above}{\figLbls}{#6}{\figPyrPos}%
    \def\figBase{#3}%
    \pgfmathsetmacro{\figProf}{0.75*(#3)}%
    \def\figSomA{#4}%
    \def\figSomB{#5}%

    \edef\figPtA{\figlabelitem{\figLbls}{1}}%
    \edef\figPtB{\figlabelitem{\figLbls}{2}}%
    \edef\figPtC{\figlabelitem{\figLbls}{3}}%
    \edef\figPtD{\figlabelitem{\figLbls}{4}}%
    \edef\figPtS{\figlabelitem{\figLbls}{5}}%

    \tkzDefPoint(0,0){\figPtA}
    \tkzDefShiftPoint[\figPtA](\figBase,0){\figPtB}
    \tkzDefShiftPoint[\figPtB](\figAngle:\figProf){\figPtC}
    \tkzDefShiftPoint[\figPtA](\figAngle:\figProf){\figPtD}
    \tkzDefTriangle[two angles={\figSomA} and {\figSomB}](\figPtA,\figPtB)
    \tkzGetPoint{\figPtS}

    \tkzDrawSegment(\figPtA,\figPtB)
    \tkzDrawSegment(\figPtB,\figPtC)
    \tkzDrawSegment(\figPtC,\figPtS)
    \tkzDrawSegment(\figPtS,\figPtB)
    \tkzDrawSegment(\figPtS,\figPtA)
    \tkzDrawSegment[dashed](\figPtA,\figPtD)
    \tkzDrawSegment[dashed](\figPtS,\figPtD)
    \tkzDrawSegment[dashed](\figPtD,\figPtC)

    \tkzLabelPoint[\figlabelitem{\figPyrPos}{1}](\figPtA){\figPtA}
    \tkzLabelPoint[\figlabelitem{\figPyrPos}{2}](\figPtB){\figPtB}
    \tkzLabelPoint[\figlabelitem{\figPyrPos}{3}](\figPtC){\figPtC}
    \tkzLabelPoint[\figlabelitem{\figPyrPos}{4}](\figPtD){\figPtD}
    \tkzLabelPoint[\figlabelitem{\figPyrPos}{5}](\figPtS){\figPtS}
  \endgroup
}

