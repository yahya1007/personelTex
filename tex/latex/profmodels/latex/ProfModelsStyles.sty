%######################################################################
% PARTIE 2 : BIBLIOTHEQUE DE STYLES GENERIQUES (ex pstyle.sty, v1.00 - 2022/12/30)
% Ces styles (style0 a style8) sont independants de ProfModels et
% peuvent etre appliques a n'importe quelle tcolorbox, par ex. :
%   \begin{tcolorbox}[style3,title=Mon titre] ... \end{tcolorbox}
%######################################################################

%----------------------------------------------------------
%%    		 style0 	 %%%%%%%%%%%%%%%%%%
\tcbset{%
  style0/.style={%
    attach boxed title to top left={xshift=0.2mm},
    boxed title size=standard,
    boxed title style={%
      empty,
      rounded corners=north, 
      boxrule=0pt,
      bottom=0pt
    },
    underlay boxed title={%
      \filldraw[rounded corners, gray!85, line width=.5mm]
      (title.south east)--++(90:\tcboxedtitleheight)--++(183:\tcboxedtitlewidth)--++(-90:\tcboxedtitleheight)|-cycle;
    }%
  }%
}%
 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 		    style1  		%%%%%%%%%%%%%
\tcbset{style1/.style={%
		 %enhanced, 
       % breakable,
        sharp corners,
        rounded corners=northwest,
        %colback=white,
       % colframe=gray!90!black,
        %fonttitle=\bfseries\large\sffamily,
        frame hidden,
        attach boxed title to top left,
        boxed title size=standard,
         boxed title style={%
                empty,
                rounded corners=north, 
                boxrule=0pt,
                bottom=0pt},
                underlay boxed title={%
                \fill[rounded corners=\kvtcb@arc,black,fill=gray!40!white, line width=.5mm]
                    (title.south east)--++(93:\tcboxedtitleheight)--++(183:\tcboxedtitlewidth)--++(-87:\tcboxedtitleheight)|-cycle;
                \draw[tcbcolframe, line width=.5mm] (title.south west)|-(frame.north east);
                }}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 		     style2  		%%%%%%%%%             
\tcbset{style2/.style={
 %breakable,
  %enhanced,
  %colback=white,
  boxrule=0pt,
  arc=0pt,
  outer arc=0pt,
  title style={gray!30!white},
  overlay={
    \draw[line width=1.5pt] (frame.south west) -- (frame.south east);
  }
}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%	           style3		%%%%%%%%%%%%%%%%%
\tcbset{
    style3/.style={%
        %enhanced, 
       % breakable,
       % colback=white,
        %colframe=gray!40!white,
        attach boxed title to top left={yshift*=-\tcboxedtitleheight}, 
        boxed title size=title,
        boxed title style={%
            sharp corners, 
            rounded corners=northwest, 
            colback=tcbcolframe, 
            boxrule=0pt,
        },
        underlay boxed title={%
            \path[fill=tcbcolframe] (title.south west)--(title.south east) 
                to[out=0, in=180] ([xshift=5mm]title.east)--
                (title.center-|frame.east)
                [rounded corners=\kvtcb@arc] |- 
                (frame.north) -| cycle; }}}              
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%                 style4    		%%%%%%
 \tcbset{style4/.style={
 %enhanced,
before skip=2mm,after skip=2mm,
%colback=white,colframe=black,
boxrule=0.4mm,
attach boxed title to top left={xshift=1cm,yshift*=1mm-\tcboxedtitleheight},
boxed title style={frame code={
\draw[fill=tcbcolback!90!gray]
([yshift=-1mm,xshift=-1mm]frame.north west)
arc[start angle=0,end angle=180,radius=1mm]
([yshift=-1mm,xshift=1mm]frame.north east)
arc[start angle=180,end angle=0,radius=1mm];
\draw[left color=tcbcolback!95!gray,right color=tcbcolback!95!gray,
middle color=white]
([xshift=-2mm]frame.north west) -- ([xshift=2mm]frame.north east)
[rounded corners=1mm]-- ([xshift=1mm,yshift=-1mm]frame.north east)
-- (frame.south east) -- (frame.south west)
-- ([xshift=-1mm,yshift=-1mm]frame.north west)
[sharp corners]-- cycle;
},interior engine=empty,
}}} 
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%    		  style5   		%%%%%%%%
\tcbset{style5/.style={
%enhanced,
skin=enhancedlast jigsaw,
attach boxed title to top left={xshift=-4mm,yshift=-0.5mm},
colbacktitle=gray!40!white,%colframe=black,
interior style={top color=white,bottom color=white},
boxed title style={empty,arc=0pt,outer arc=0pt,boxrule=0pt},
underlay boxed title={
\filldraw[gray!40!white] (title.north west) -- (title.north east)
-- +(\tcboxedtitleheight-1mm,-\tcboxedtitleheight+1mm)
-- ([xshift=4mm,yshift=0.5mm]frame.north east) -- +(0mm,-1mm)
-- (title.south west) -- cycle;
\filldraw[blue!45!white!50!black] ([yshift=-0.5mm]frame.north west)
-- +(-0.4,0) -- +(0,-0.3) -- cycle;
\fill[blue!45!white!50!black] ([yshift=-0.5mm]frame.north east)
-- +(0,-0.3) -- +(0.4,0) -- cycle; }}}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%     			style6			%%%%%%%%%%%%%
\tcbset{style6/.style={
%enhanced,breakable,
	before skip=2mm,after skip=0.3cm,
	bottom=0.5cm,%colframe=black,
	%colback=gray!2,
	boxrule=0.2mm,arc=2mm,drop midday shadow=gray,
	attach boxed title to top left={xshift=0cm,yshift*=0mm-\tcboxedtitleheight},
	boxed title style={frame code={
			\draw[fill=gray!30!white]
			([xshift=+0.5cm]frame.north east)[rounded corners=2mm]--(frame.north west)[sharp corners]--(frame.south west) --(frame.south east)to[out=0,in=180]cycle;
			\draw[#1]([yshift=-0.5mm]frame.south west)--([yshift=-0.5mm,xshift=+0.4mm]frame.south east)to[out=0,in=180]([yshift=0mm,xshift=+0.58cm]frame.north east);
		},interior engine=empty,
	},pad at break*=4mm}}   
	%----------------------------------------------
	%---------- Style7 -------------------------
	%\tcbuselibrary{skins}
	\tcbset{style7/.style={%
	 before=\bigskip\centering,
  after=\bigskip,
 % breakable, 
  enhanced,  colback=white, 
  sharp corners, 
  rounded corners=southeast,
  arc=25pt, 
  attach boxed title to top left={xshift=5pt}, 
  boxed title style={%
    enhanced, 
    colframe=gray, 
    colback=gray, 
    borderline east={1.5pt}{8pt}{white}, 
    borderline east={1.5pt}{3.5pt}{white},
    borderline east={3.5pt}{0pt}{white},    
    borderline east={2.75pt}{0.25pt}{gray!50},    
    borderline east={2.75pt}{-4pt}{gray!20},    
    bottomrule=0pt, 
    rightrule=5pt, 
    sharp corners, 
  },
  interior style={}, 
  frame code={%
    \begin{scope}[line width=1.5pt, gray]
      \fill[shade, bottom color=gray!30, top color=white]
      ([xshift=-30pt]frame.south east)
      to[out=0, in=-90] ([yshift=30pt]frame.south east)
      -- ([shift={(-1pt, 15pt)}]frame.south east)
      to[out=-90, in=0] ([xshift=-25pt]frame.south east);
      \draw
      ([shift={(-1pt, 19pt)}]frame.north west) coordinate (iniPoint)
      -- ([xshift=-1pt]frame.south west)
      -- ([xshift=-30pt]frame.south east)
      to[out=0, in=-90] ([yshift=30pt]frame.south east)
      -- ([yshift=5pt]frame.north east) -- ++(-5, 0) coordinate (endPoint);
      \draw (endPoint) -- ++(-5pt, 5pt) -- ++(-5pt, -5pt)     -- ++(5pt, -5pt) -- cycle;
      \draw (iniPoint) -- ++(4pt, 0) -- ++(-8pt, 0);
      \draw (iniPoint) ++(0, -10pt) -- ++(6pt, 0) -- ++(-12pt, 0);
      \draw (iniPoint) ++(0, -14pt) -- ++(6pt, 0) -- ++(-12pt, 0);
    \end{scope}  
	}}}
	%------------ Style8 -----------------------
\definecolor{textnewGreen}{HTML}{66AE3E}
\definecolor{bgnewGreen}{HTML}{EBF4DE}

\newtcbox{\titlebox}{
  enhanced,
  colupper=white,
  colback=textnewGreen,
  fontupper=\bfseries,
  size=small,
  baseline=3pt,
  nobeforeafter,
  frame code={
    \path[fill=textnewGreen] (frame.north west)
    -- ([xshift=2mm]frame.north east)
    -- (frame.south east)
    -- (frame.south west)
    -- (frame.north west)
      [sharp corners]-- cycle;
  }
}%
\tcbset{style8/.style={%
  %enhanced,
  %skin=bicolor,
  arc=0pt,
  coltitle=white,
  %colframe=textnewGreen,
  %colback=bgnewGreen,
  %colbacklower=white,
  fonttitle=\bfseries,
  detach title,
  %title=Exercice,
  before upper*={%
    \vskip-\dimexpr\kvtcb@boxsep+\kvtcb@top+.1pt
    \hspace*{-\dimexpr\kvtcb@boxsep+\kvtcb@leftupper+.1pt}%
    \expandafter\titlebox\expandafter{\tcbtitletext} %
  }}}
  %=================================================
  \tcbset{style9/.style={%
    top=8mm,
     before skip=5mm,after skip=5mm, boxsep=-1mm,boxrule=1pt,colframe=cyan,colback=cyan!5,sharp corners,rounded corners=southeast,arc=3mm,
        drop fuzzy shadow=cyan!50!gray,
        coltitle=black,attach boxed title to top left={xshift=-2mm,yshift=-\tcboxedtitleheight},boxed title style={interior empty,
        frame code={
            \fill([xshift=-2mm]frame.north east)arc(180:0:1mm);
            \fill[right color=gray,left color=gray!50,middle color=gray!50] ([shift={(.3,.1)}]frame.north west)--([shift={(-.1,.1)}]frame.north east)[rounded corners=1mm]--([xshift=-2mm]frame.north east)--([xshift=-3mm]frame.south east)--([xshift=1mm]frame.south west)--([xshift=2mm]frame.north west)--cycle;
}}}}


