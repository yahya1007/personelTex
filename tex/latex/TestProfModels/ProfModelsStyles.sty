   \textbf{\useKV[DS]{Niveau}.A.C\useKV[DS]{Classe}}
   \end{Large}\vspace*{2mm}
   
   \textbf{\sffamily Mathématiques}\hfill \useKV[DS]{Sujet} \hfill\textbf{\useKV[DS]{Date}}
