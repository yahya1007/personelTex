\NewDocumentCommand{\cercle}{ O{} O{} m }{%
  \figsetdefault{#1}{30}{\figAngle}%
  \figsetdefault{#2}{O,A}{\figLbls}%
  \def\figR{#3}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figR){\figlabelitem{\figLbls}{2}}

  \tkzDrawCircle(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
  \tkzDrawPoint(\figlabelitem{\figLbls}{1})
  \tkzDrawPoint(\figlabelitem{\figLbls}{2})

  \tkzLabelPoint[below](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[above right](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
}
%==============================================================
% --------------------------------------------------------------
% \secantesParalleles*[angle][labels]{angleSecantes}{dist1}{dist2}
% --------------------------------------------------------------
% *        : version "papillon" (O entre les deux parallèles)
% #1 (opt) : rotation globale en degrés (défaut 0)
% #2 (opt) : liste des labels, par défaut O,A,B,C,D
% #3       : angle entre les deux sécantes (défaut 40)
% #4       : distance O -- première parallèle
% #5       : distance O -- deuxième parallèle
% --------------------------------------------------------------
\NewDocumentCommand{\thales}{ s O{} O{} m m m }{%
  \figsetdefault{#2}{0}{\figAngle}%
  \figsetdefault{#3}{O,A,B,C,D}{\figLbls}%
  \def\figSecAngle{#4}%
  \def\figDistA{#5}%
  \def\figDistB{#6}%

  % Sommet O
  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}

  % Angle de la deuxième sécante
  \pgfmathsetmacro{\figAngleB}{\figAngle+\figSecAngle}

  \IfBooleanTF{#1}
{% --- Configuration papillon : O entre les deux parallèles ---
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figDistA){\figlabelitem{\figLbls}{2}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:-\figDistB){\figlabelitem{\figLbls}{3}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngleB:\figDistA){\figlabelitem{\figLbls}{4}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngleB:-\figDistB){\figlabelitem{\figLbls}{5}}
      % Sécantes prolongées ----------------------------
  \tkzDrawLine[add=0.1 and 0.1](\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3})
  \tkzDrawLine[add=0.1 and 0.1](\figlabelitem{\figLbls}{4},\figlabelitem{\figLbls}{5})
  % Labels -----------------------------------
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[below right](\figlabelitem{\figLbls}{5}){\figlabelitem{\figLbls}{5}}
    }
{% --- Configuration standard : O au-delà des parallèles ---
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figDistA){\figlabelitem{\figLbls}{2}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figDistB){\figlabelitem{\figLbls}{3}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngleB:\figDistA){\figlabelitem{\figLbls}{4}}
      \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngleB:\figDistB){\figlabelitem{\figLbls}{5}}
     % Sécantes prolongées ---------------------
  \tkzDrawLine[add=0.1 and 0.1](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{3})
  \tkzDrawLine[add=0.1 and 0.1](\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{5})
  % Labels --------------------------------
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[above left](\figlabelitem{\figLbls}{5}){\figlabelitem{\figLbls}{5}}
    }

  % Parallèles
  \tkzDrawSegment(\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{4})
  \tkzDrawSegment(\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{5})

  % Points
  \tkzDrawPoints(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2},
                 \figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{4},
                 \figlabelitem{\figLbls}{5})

  % Labels
  \tkzLabelPoint[above left](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
  \tkzLabelPoint[above left](\figlabelitem{\figLbls}{4}){\figlabelitem{\figLbls}{4}}
}%
