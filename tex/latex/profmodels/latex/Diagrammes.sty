% -------------------- Repère et coordonnées de points--------
% \begin{Repere}\coordpoints{x}{y}{A}\end{Repere}
\NewDocumentEnvironment { Repere } { O{-4} O{5} O{-3} O{5} }
{
\def\repadd{.5}
\begin{tikzpicture}
\tkzInit[xmin=#1,xmax=#2,ymin=#3,ymax=#4,xstep=1,ystep=1]
\tkzGrid[sub,subxstep=0.5,subystep=0.5](#1-0.2,#3-0.2)(#2+0.3,#4+0.3)
\tkzLabelX[orig=true,below left=3pt]
\tkzLabelY[orig=false]
\tkzDrawXY[label={}]               
}{\end{tikzpicture}}

\newcommand{\coordpoints}[3]{   
\tkzDefPoint(#1,#2){#3}
\tkzDrawPoint(#3)
\ifthenelse{\lengthtest{#2 pt < 0 pt}}%
{\tkzLabelPoint[below right](#3){#3}}
{\tkzLabelPoint[above right](#3){#3}}
\checknextarg
}

\newcommand{\checknextarg}{\@ifnextchar\bgroup{\gobblenextarg}{%
 }}
\newcommand{\gobblenextarg}[3]{
\tkzDefPoint(#1,#2){#3}
\tkzDrawPoint(#3)
\ifthenelse{\lengthtest{#2 pt < 0 pt}}%
{\tkzLabelPoint[below right](#3){#3}}
{\tkzLabelPoint[above right](#3){#3}}
 \@ifnextchar\bgroup{\gobblenextarg}{}}
%----------Fin repere --------------------------------------
% -------------------- Droite graduée --------------------------
% \begin{DroiteGraduee}[xmin][xmax][pas][sous-graduations]
%     \pointgradue{x}{A}{x2}{B}...
% \end{DroiteGraduee}
% #1 = abscisse minimale (défaut -5)
% #2 = abscisse maximale (défaut 5)
% #3 = pas des graduations principales, numérotées (défaut 1)
% #4 = nombre de sous-graduations (sans numéro) entre deux graduations
%      principales (défaut 0, c'est-à-dire aucune)
%---------------EXAMPLE---------------------
%\begin{DroiteGraduee}[-3][6][1][5]
%\pointgradue{-1.5}{A}{2}{B}{4.5}{C}{6}{H}
%\end{DroiteGraduee}
%---------------------------------------------
\NewDocumentEnvironment { DroiteGraduee } { O{-5} O{5} O{1} O{0} }
{
\begin{tikzpicture}
% NB : on calcule les positions avec \pgfmathsetmacro et on boucle sur des
% entiers (\i, \j) plutôt que d'utiliser la syntaxe {a,a+pas,...,b} de
% \foreach avec un pas décimal : cette dernière échoue dès que le pas
% n'est pas un entier simple et casse la compilation.
\pgfmathtruncatemacro{\NGrad}{round((#2-#1)/(#3))}
\draw[thick,->,>=latex] ({#1-0.7*(#3)},0) -- ({#2+0.9*(#3)},0) ;
\ifnum#4>0
	\pgfmathsetmacro{\souspas}{(#3)/(#4+1)}
	\foreach \i in {0,...,\NGrad}
		{%
			\ifnum\i<\NGrad
				\foreach \j in {1,...,#4}
					{%
\pgfmathsetmacro{\xsub}{#1+\i*(#3)+\j*(\souspas)}
\draw[thin] (\xsub,-1.5pt) -- (\xsub,1.5pt) ;
					}%
			\fi
		}%
\fi
\foreach \i in {0,...,\NGrad}
	{%
		\pgfmathsetmacro{\x}{#1+\i*(#3)}
		\draw[thick] (\x,-3pt) -- (\x,3pt) node[below=2pt] {\pgfmathprintnumber{\x}} ;
	}%
}{\end{tikzpicture}}

\newcommand{\pointgradue}[2]{
\filldraw (#1,0) circle (1.5pt) ;
\draw (#1,0) node[above=2pt] {#2} ;
\checknextargGradue
}

\newcommand{\checknextargGradue}{\@ifnextchar\bgroup{\gobblenextargGradue}{%
 }}
\newcommand{\gobblenextargGradue}[2]{
\filldraw (#1,0) circle (1.5pt) ;
\draw (#1,0) node[above=2pt] {#2} ;
\@ifnextchar\bgroup{\gobblenextargGradue}{}}
