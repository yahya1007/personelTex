% --------------------------------------------------------------
% \cylindre[arc][prefixe]{rayon}{hauteur}
% --------------------------------------------------------------
\NewDocumentCommand{\cylindre}{ O{} O{} m m O{} }{%
  \figsetdefault{#1}{0.5}{\figArc}%
  \figsetdefault{#2}{O}{\figLbls}%
  \figposresolve{below}{\figLbls}{#5}{\figBasePos}%
  \def\figR{#3}%
  \def\figH{#4}%
  % --- \figBase, \figR et \figArc sont VOLONTAIREMENT globales : ---
  % --- \cylpoint en a besoin lors d'un appel ultérieur.        ---
  \edef\figBase{\figlabelitem{\figLbls}{1}}%

  % --- Centres ---
  \tkzDefPoint(0,0){\figBase}
  \tkzDefShiftPoint[\figBase](0,\figH){\figBase h}

  % --- Points gauche / droite (bas et haut) ---
  \tkzDefPoint(\figR,0){\figBase D}
  \tkzDefPoint(-\figR,0){\figBase G}
  \tkzDefShiftPoint[\figBase D](0,\figH){\figBase Dh}
  \tkzDefShiftPoint[\figBase G](0,\figH){\figBase Gh}

  % --- Points avant / arrière (bas et haut) ---
  \tkzDefPoint(0,-\figArc){\figBase Av}
  \tkzDefPoint(0,\figArc){\figBase Ar}
  \tkzDefShiftPoint[\figBase Av](0,\figH){\figBase Avh}
  \tkzDefShiftPoint[\figBase Ar](0,\figH){\figBase Arh}

  % --- Génératrices verticales ---
  \tkzDrawSegments[thick](\figBase G,\figBase Gh \figBase D,\figBase Dh)

  % --- Cercle du haut (entièrement visible) ---
  \tkzDrawEllipse[thick](\figBase h,\figR cm,\figArc cm,0)

  % --- Cercle du bas : moitié cachée ---
  \begin{scope}
    \clip (-\figR-0.1,0) rectangle (\figR+0.1,\figArc+0.1);
    \tkzDrawEllipse[dashed](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  % --- Cercle du bas : moitié visible ---
  \begin{scope}
    \clip (-\figR-0.1,-\figArc-0.1) rectangle (\figR+0.1,0);
    \tkzDrawEllipse[thick](\figBase,\figR cm,\figArc cm,0)
  \end{scope}

  \tkzDrawPoint(\figBase)
  \tkzLabelPoint[\figBasePos](\figBase){\figBase}
}

% --------------------------------------------------------------
% \cylpoint{angle}{bas|haut}{nom}
% Place un point sur le contour elliptique à l'angle donné (°),
% à appeler juste après \cylindre, dans la même tikzpicture.
%  \cylindre[0.5]{2}{4}
%  \foreach \pt in {O,Oh,OD,OG,ODh,OGh,OAv,OAr,OAvh,OArh}{
%    \tkzDrawPoint[red](\pt)
%    \tkzLabelPoint[above right](\pt){\tiny\pt}
%  }
% --------------------------------------------------------------
\ExplSyntaxOn
\NewDocumentCommand{\cylpoint}{ m m m }
  {
    \cs_if_exist:NTF \figBase
      {
        \group_begin:
          \pgfmathsetmacro{\figPX}{\figR*cos(#1)}
          \pgfmathsetmacro{\figPY}{\figArc*sin(#1)}
          \str_if_eq:eeTF {#2} {haut}
            { \tkzDefShiftPoint[\figBase h](\figPX,\figPY){#3} }
            { \tkzDefShiftPoint[\figBase](\figPX,\figPY){#3} }
        \group_end:
      }
      { \PackageError{cylindre}{\string\cylpoint~utilisé~sans~\string\cylindre~préalable}{Appelez~\string\cylindre~avant~\string\cylpoint~dans~la~même~figure.} }
  }
\ExplSyntaxOff
