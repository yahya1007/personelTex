% --------------------------------------------------------------
% \cercle[angle][labels]{rayon}
% --------------------------------------------------------------
\NewDocumentCommand{\cercle}{ O{} O{} m }{%
  \figsetdefault{#1}{30}{\figAngle}%
  \figsetdefault{#2}{O,A}{\figLbls}%
  \def\figR{#3}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figAngle:\figR){\figlabelitem{\figLbls}{2}}

  \draw (\figlabelitem{\figLbls}{1}) circle (\figR cm);
  \tkzDrawSegment(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2})
