%============================================================
\ExplSyntaxOn
\NewDocumentCommand{\figsetdefault}{ m m m }
  {
    \tl_if_blank:nTF {#1}
      { \def#3{#2} }
      { \def#3{#1} }
  }

\cs_generate_variant:Nn \clist_item:nn { o }

\NewExpandableDocumentCommand{\figlabelitem}{ m m }
  {
    \clist_item:on {#1} {#2}
  }

% ==============================================================
% \figposresolve{defaults}{labels}{useroverride}{\resultcs}
%
% Resout la liste des positions d'une figure, en acceptant DEUX
% syntaxes pour "useroverride" :
%   - vide                     -> on garde "defaults" tel quel
%   - liste positionnelle      -> "above,above,below,below"
%     (une position par point, dans l'ordre, comme avant)
%   - liste cible par nom      -> "P=above,S=below"
%     (seuls les points cites sont modifies, les autres gardent
%      leur position par defaut)
% Le resultat (une liste positionnelle complete) est stocke
% dans la macro \resultcs.
% ==============================================================
\prop_new:N \l_fig_overrides_prop
\tl_new:N \l_fig_result_tl
\tl_new:N \l_fig_val_tl
\tl_new:N \l_fig_defaults_tl
\tl_new:N \l_fig_labels_tl
\tl_new:N \l_fig_override_tl
\int_new:N \l_fig_idx_int

\cs_new_protected:Npn \fig_store_override:w #1 = #2 \q_stop
  {
    \prop_put:Nnn \l_fig_overrides_prop { #1 } { #2 }
  }

\cs_new_protected:Npn \fig_build_by_name:nnn #1 #2 #3
  {
    \prop_clear:N \l_fig_overrides_prop
    \clist_map_inline:nn { #3 }
      { \fig_store_override:w ##1 \q_stop }
    \tl_clear:N \l_fig_result_tl
    \int_zero:N \l_fig_idx_int
    \clist_map_inline:nn { #2 }
      {
        \int_incr:N \l_fig_idx_int
        \prop_get:NnNTF \l_fig_overrides_prop { ##1 } \l_fig_val_tl
          { }
          {
            \tl_set:Nx \l_fig_val_tl
              { \clist_item:nn {#1} {\int_use:N \l_fig_idx_int} }
          }
        \tl_if_empty:NTF \l_fig_result_tl
          { \tl_set_eq:NN \l_fig_result_tl \l_fig_val_tl }
          { \tl_put_right:Nx \l_fig_result_tl { , \l_fig_val_tl } }
      }
  }
\cs_generate_variant:Nn \fig_build_by_name:nnn { VVV }

\NewDocumentCommand{\figposresolve}{ m m m m }
  {
    \tl_if_blank:nTF { #3 }
      { \tl_set:Nn #4 { #1 } }
      {
        \str_if_in:nnTF { #3 } { = }
          {
            \tl_set:Nx \l_fig_defaults_tl { #1 }
            \tl_set:Nx \l_fig_labels_tl { #2 }
            \tl_set:Nx \l_fig_override_tl { #3 }
            \fig_build_by_name:VVV \l_fig_defaults_tl \l_fig_labels_tl \l_fig_override_tl
            \tl_set_eq:NN #4 \l_fig_result_tl
          }
          { \tl_set:Nn #4 { #3 } }
      }
  }
\ExplSyntaxOff

