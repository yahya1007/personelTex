% \carre[labels]{cote}
% --------------------------------------------------------------
\NewDocumentCommand{\carre}{ O{} m }{%
  \figsetdefault{#1}{A,B,C,D}{\figLbls}%
  \def\figC{#2}%

  \tkzDefPoint(0,0){\figlabelitem{\figLbls}{1}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](\figC,0){\figlabelitem{\figLbls}{2}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{2}](90:\figC){\figlabelitem{\figLbls}{3}}
  \tkzDefShiftPoint[\figlabelitem{\figLbls}{1}](90:\figC){\figlabelitem{\figLbls}{4}}

  \tkzDrawPolygon(\figlabelitem{\figLbls}{1},\figlabelitem{\figLbls}{2},\figlabelitem{\figLbls}{3},\figlabelitem{\figLbls}{4})

  \tkzLabelPoint[below](\figlabelitem{\figLbls}{1}){\figlabelitem{\figLbls}{1}}
  \tkzLabelPoint[below](\figlabelitem{\figLbls}{2}){\figlabelitem{\figLbls}{2}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{3}){\figlabelitem{\figLbls}{3}}
  \tkzLabelPoint[above](\figlabelitem{\figLbls}{4}){\figlabelitem{\figLbls}{4}}
}

